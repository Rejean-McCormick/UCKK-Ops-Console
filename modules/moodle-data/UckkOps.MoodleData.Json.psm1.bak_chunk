#Requires -Version 7.0
<#
.SYNOPSIS
  JSON validation helpers for UCKK Moodle Data.

.DESCRIPTION
  This module reads and validates Moodle data JSON source files.

  It does not write to Moodle.
  It does not run SQL.
  It does not modify local or server data.
  It does not apply anything.

  Its role is limited to:
    - resolve configured Moodle data JSON paths;
    - read JSON files;
    - validate required fields;
    - detect duplicates;
    - detect missing dependencies;
    - return structured validation results.

.CONTRACT
  See:
    docs/05_CONFIGURATION_ET_CHEMINS.md
    docs/09_DONNEES_MOODLE_CONTRAT.md
    docs/10_RAPPORTS_LOGS_ERREURS.md
    docs/12_CONTRAT_TECHNIQUE_DU_CODE.md
#>

Set-StrictMode -Off
# ---------------------------------------------------------------------------
# Public: domain definitions
# ---------------------------------------------------------------------------

function Get-UckkOpsMoodleDataDomainDefinitions {
    <#
    .SYNOPSIS
      Returns the official Moodle data JSON domains.

    .DESCRIPTION
      These definitions control how JSON source files are located and validated.

      The file names are defaults only.
      They can be overridden in config under moodleData.*File.
    #>

    [CmdletBinding()]
    param()

    return @(
        [pscustomobject]@{
            domain          = "categories"
            label           = "Catégories Moodle"
            configKey       = "moodleData.categoriesFile"
            defaultFile     = "categories.json"
            itemNames       = @("categories", "items", "data")
            stableKeys      = @("idnumber", "key", "slug", "shortname")
            requiredFields  = @("name")
            dependencyRules = @()
        }

        [pscustomobject]@{
            domain          = "courses"
            label           = "Cours Moodle"
            configKey       = "moodleData.coursesFile"
            defaultFile     = "courses.json"
            itemNames       = @("courses", "items", "data")
            stableKeys      = @("idnumber", "shortname", "key", "slug")
            requiredFields  = @("fullname", "shortname")
            dependencyRules = @(
                [pscustomobject]@{
                    field        = "category"
                    dependsOn    = "categories"
                    dependsOnKey = @("idnumber", "key", "slug", "shortname")
                    required     = $false
                    label        = "catégorie"
                }
            )
        }

        [pscustomobject]@{
            domain          = "programs"
            label           = "Programmes"
            configKey       = "moodleData.programsFile"
            defaultFile     = "programs.json"
            itemNames       = @("programs", "programmes", "items", "data")
            stableKeys      = @("key", "slug", "idnumber", "code")
            requiredFields  = @("name")
            dependencyRules = @()
        }

        [pscustomobject]@{
            domain          = "pathways"
            label           = "Parcours"
            configKey       = "moodleData.pathwaysFile"
            defaultFile     = "pathways.json"
            itemNames       = @("pathways", "parcours", "items", "data")
            stableKeys      = @("key", "slug", "idnumber", "code")
            requiredFields  = @("name")
            dependencyRules = @(
                [pscustomobject]@{
                    field        = "program"
                    dependsOn    = "programs"
                    dependsOnKey = @("key", "slug", "idnumber", "code")
                    required     = $true
                    label        = "programme"
                }
            )
        }

        [pscustomobject]@{
            domain          = "roles"
            label           = "Rôles"
            configKey       = "moodleData.rolesFile"
            defaultFile     = "roles.json"
            itemNames       = @("roles", "items", "data")
            stableKeys      = @("shortname", "key", "idnumber")
            requiredFields  = @("name", "shortname")
            dependencyRules = @()
        }

        [pscustomobject]@{
            domain          = "permissions"
            label           = "Permissions"
            configKey       = "moodleData.permissionsFile"
            defaultFile     = "permissions.json"
            itemNames       = @("permissions", "items", "data")
            stableKeys      = @("key", "capability")
            requiredFields  = @("capability")
            dependencyRules = @(
                [pscustomobject]@{
                    field        = "role"
                    dependsOn    = "roles"
                    dependsOnKey = @("shortname", "key", "idnumber")
                    required     = $true
                    label        = "rôle"
                }
            )
        }

        [pscustomobject]@{
            domain          = "badges"
            label           = "Badges"
            configKey       = "moodleData.badgesFile"
            defaultFile     = "badges.json"
            itemNames       = @("badges", "items", "data")
            stableKeys      = @("key", "slug", "idnumber")
            requiredFields  = @("name")
            dependencyRules = @()
        }

        [pscustomobject]@{
            domain          = "competencies"
            label           = "Compétences"
            configKey       = "moodleData.competenciesFile"
            defaultFile     = "competencies.json"
            itemNames       = @("competencies", "competences", "items", "data")
            stableKeys      = @("idnumber", "key", "slug", "shortname")
            requiredFields  = @("name")
            dependencyRules = @()
        }

        [pscustomobject]@{
            domain          = "templates"
            label           = "Modèles"
            configKey       = "moodleData.templatesFile"
            defaultFile     = "templates.json"
            itemNames       = @("templates", "modeles", "items", "data")
            stableKeys      = @("key", "slug", "idnumber")
            requiredFields  = @("name")
            dependencyRules = @()
        }

        [pscustomobject]@{
            domain          = "reports"
            label           = "Rapports Moodle"
            configKey       = "moodleData.reportsFile"
            defaultFile     = "reports.json"
            itemNames       = @("reports", "rapports", "items", "data")
            stableKeys      = @("key", "slug", "idnumber")
            requiredFields  = @("name")
            dependencyRules = @()
        }
    )
}

function Get-UckkOpsMoodleDataDomainDefinition {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $Domain
    )

    $definitions = Get-UckkOpsMoodleDataDomainDefinitions

    foreach ($definition in $definitions) {
        if ($definition.domain -eq $Domain) {
            return $definition
        }
    }

    throw "Domaine Données Moodle inconnu : $Domain"
}

# ---------------------------------------------------------------------------
# Public: path resolution
# ---------------------------------------------------------------------------

function Get-UckkOpsMoodleDataSourceDir {
    <#
    .SYNOPSIS
      Resolves the Moodle data JSON source directory from config.

    .DESCRIPTION
      Preferred config:
        moodleData.sourceDir

      Fallback base:
        paths.uckkMoodleSource

      Default relative source dir:
        academic_registry_json
    #>

    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config
    )

    $configured = Get-UckkOpsNestedValue `
        -Object $Config `
        -Name "moodleData.sourceDir" `
        -Default ""

    if (-not $configured) {
        $configured = "academic_registry_json"
    }

    if (Test-UckkOpsLocalPathLike -Path $configured) {
        return Normalize-UckkOpsJsonLocalPath -Path $configured -AllowMissing
    }

    $repoRoot = Get-UckkOpsNestedValue `
        -Object $Config `
        -Name "paths.uckkMoodleSource" `
        -Default ""

    if (-not $repoRoot) {
        $repoRoot = Get-UckkOpsNestedValue `
            -Object $Config `
            -Name "git.repoRoot" `
            -Default ""
    }

    if (-not $repoRoot) {
        throw "Impossible de résoudre le dossier Données Moodle : moodleData.sourceDir est relatif et paths.uckkMoodleSource est absent."
    }

    $base = Normalize-UckkOpsJsonLocalPath -Path $repoRoot -AllowMissing
    return Join-UckkOpsJsonLocalPath -BasePath $base -ChildPath $configured
}

function Get-UckkOpsMoodleDataJsonFilePath {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config,

        [Parameter(Mandatory)]
        [string] $Domain
    )

    $definition = Get-UckkOpsMoodleDataDomainDefinition -Domain $Domain
    $sourceDir = Get-UckkOpsMoodleDataSourceDir -Config $Config

    $configuredFile = Get-UckkOpsNestedValue `
        -Object $Config `
        -Name $definition.configKey `
        -Default ""

    if (-not $configuredFile) {
        $configuredFile = $definition.defaultFile
    }

    if (Test-UckkOpsLocalPathLike -Path $configuredFile) {
        return Normalize-UckkOpsJsonLocalPath -Path $configuredFile -AllowMissing
    }

    return Join-UckkOpsJsonLocalPath -BasePath $sourceDir -ChildPath $configuredFile
}

function Get-UckkOpsMoodleDataJsonFileMap {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config,

        [Parameter()]
        [string[]] $Domains = @()
    )

    $definitions = Get-UckkOpsMoodleDataDomainDefinitions

    if ($Domains.Count -gt 0) {
        $definitions = @($definitions | Where-Object { $Domains -contains $_.domain })
    }

    $map = [ordered]@{}

    foreach ($definition in $definitions) {
        $map[$definition.domain] = [pscustomobject]@{
            domain = $definition.domain
            label  = $definition.label
            path   = Get-UckkOpsMoodleDataJsonFilePath -Config $Config -Domain $definition.domain
        }
    }

    return [pscustomobject]$map
}

# ---------------------------------------------------------------------------
# Public: read JSON
# ---------------------------------------------------------------------------

function Read-UckkOpsMoodleDataJsonFile {
    <#
    .SYNOPSIS
      Reads one Moodle data JSON file.

    .OUTPUTS
      Object with file status, parsed JSON and extracted items.
    #>

    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $Path,

        [Parameter(Mandatory)]
        [string] $Domain
    )

    $definition = Get-UckkOpsMoodleDataDomainDefinition -Domain $Domain

    $result = [ordered]@{
        domain      = $Domain
        label       = $definition.label
        path        = $Path
--- CHUNK END ---

        exists      = $false
        ok          = $false
        json        = $null
        items       = @()
        itemCount   = 0
        warnings    = @()
        errors      = @()
    }

    if ([string]::IsNullOrWhiteSpace($Path)) {
        $result.errors += "Chemin JSON vide pour le domaine $Domain."
        return [pscustomobject]$result
    }

    if (Test-UckkOpsServerPathLike -Path $Path) {
        $result.errors += "Le chemin JSON est un chemin serveur. Ce module lit seulement les fichiers locaux : $Path"
        return [pscustomobject]$result
    }

    if (Test-UckkOpsUrlLike -Value $Path) {
        $result.errors += "Le chemin JSON est une URL. Ce module lit seulement les fichiers locaux : $Path"
        return [pscustomobject]$result
    }

    $normalized = Normalize-UckkOpsJsonLocalPath -Path $Path -AllowMissing
    $result.path = $normalized

    if (-not (Test-Path -LiteralPath $normalized)) {
        $result.errors += "Fichier JSON introuvable : $normalized"
        return [pscustomobject]$result
    }

    $result.exists = $true

    try {
        $raw = Get-Content -LiteralPath $normalized -Raw -Encoding UTF8
    }
    catch {
        $result.errors += "Impossible de lire le fichier JSON : $($_.Exception.Message)"
        return [pscustomobject]$result
    }

    if ([string]::IsNullOrWhiteSpace($raw)) {
        $result.errors += "Fichier JSON vide : $normalized"
        return [pscustomobject]$result
    }

    try {
        $json = $raw | ConvertFrom-Json -Depth 100
        $result.json = $json
    }
    catch {
        $result.errors += "JSON invalide : $($_.Exception.Message)"
        return [pscustomobject]$result
    }

    $items = Get-UckkOpsMoodleDataItemsFromJson `
        -Json $result.json `
        -Definition $definition

    $result.items = @($items)
    $result.itemCount = @($items).Count
    $result.ok = $true

    if ($result.itemCount -eq 0) {
        $result.warnings += "Aucun élément trouvé dans $($definition.label)."
    }

    return [pscustomobject]$result
}

function Get-UckkOpsMoodleDataItemsFromJson {
    [CmdletBinding()]
    param(
        [Parameter()]
        [object] $Json,

        [Parameter(Mandatory)]
        [object] $Definition
    )

    if (-not $Json) {
        return @()
    }

    if ($Json -is [array]) {
        return @($Json)
    }

    foreach ($name in $Definition.itemNames) {
        if ($Json.PSObject.Properties.Name -contains $name) {
            $value = $Json.$name

            if ($value -is [array]) {
                return @($value)
            }

            if ($null -ne $value) {
                return @($value)
            }
        }
    }

    if ($Json.PSObject.Properties.Name -contains "items") {
        return @($Json.items)
    }

    if ($Json.PSObject.Properties.Name -contains "data") {
        return @($Json.data)
    }

    return @($Json)
}

# ---------------------------------------------------------------------------
# Public: validation
# ---------------------------------------------------------------------------

function Test-UckkOpsMoodleDataJsonFiles {
    <#
    .SYNOPSIS
      Validates all configured Moodle data JSON files.

    .OUTPUTS
      Structured validation object.
    #>

    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config,

        [Parameter()]
        [string[]] $Domains = @("categories", "courses", "programs", "pathways")
    )

    $startedAt = Get-Date

    $domainResults = @()
    $warnings = @()
    $errors = @()

    foreach ($domain in $Domains) {
        $domainResult = Test-UckkOpsMoodleDataDomainJson `
            -Config $Config `
            -Domain $domain

        $domainResults += $domainResult
        $warnings += @($domainResult.warnings)
        $errors += @($domainResult.errors)
    }

    $dependencyResults = Test-UckkOpsMoodleDataDependencies `
        -DomainResults $domainResults

    $warnings += @($dependencyResults.warnings)
    $errors += @($dependencyResults.errors)

    $validItemCount = 0
    $invalidItemCount = 0

    foreach ($domainResult in $domainResults) {
        $validItemCount += [int] $domainResult.validItemCount
        $invalidItemCount += [int] $domainResult.invalidItemCount
    }

    $ok = ($errors.Count -eq 0)

    return [pscustomobject]@{
        success          = $ok
        status           = $(if ($ok -and $warnings.Count -eq 0) { "Réussi" } elseif ($ok) { "Réussi avec avertissements" } else { "Échoué" })
        action           = "Vérifier fichiers JSON Moodle"
        domain           = "moodle-data"
        target           = "fichiers JSON"
        dangerLevel      = 1
        mode             = "vérification"
        summary          = $(if ($ok) { "Les fichiers JSON Moodle ont été vérifiés." } else { "La vérification des fichiers JSON Moodle a échoué." })
        warnings         = @($warnings)
        errors           = @($errors)
        nextStep         = $(if ($ok) { "Lancer une simulation locale ou serveur selon le besoin." } else { "Corriger les fichiers JSON, puis relancer la vérification." })
        reportPath       = ""
        logPath          = ""
        data             = [pscustomobject]@{
            startedAt        = $startedAt
            endedAt          = Get-Date
            domains          = $Domains
            domainResults    = $domainResults
            validItemCount   = $validItemCount
            invalidItemCount = $invalidItemCount
        }
    }
}

function Test-UckkOpsMoodleDataDomainJson {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config,

        [Parameter(Mandatory)]
        [string] $Domain
    )

    $definition = Get-UckkOpsMoodleDataDomainDefinition -Domain $Domain
    $path = Get-UckkOpsMoodleDataJsonFilePath -Config $Config -Domain $Domain

    $read = Read-UckkOpsMoodleDataJsonFile `
        -Path $path `
        -Domain $Domain

    $warnings = @($read.warnings)
    $errors = @($read.errors)

    $itemResults = @()
    $validItemCount = 0
    $invalidItemCount = 0

    if ($read.ok) {
        $index = 0

        foreach ($item in @($read.items)) {
            $index++

            $itemResult = Test-UckkOpsMoodleDataItem `
                -Item $item `
                -Index $index `
                -Definition $definition

            $itemResults += $itemResult
            $warnings += @($itemResult.warnings)
            $errors += @($itemResult.errors)

            if ($itemResult.ok) {
                $validItemCount++
            }
            else {
                $invalidItemCount++
            }
        }

        $duplicateResult = Test-UckkOpsMoodleDataDuplicateKeys `
            -Items @($read.items) `
            -Definition $definition

        $warnings += @($duplicateResult.warnings)
        $errors += @($duplicateResult.errors)
    }

    $ok = ($errors.Count -eq 0)

    return [pscustomobject]@{
        domain           = $Domain
        label            = $definition.label
        path             = $read.path
        exists           = $read.exists
        ok               = $ok
        itemCount        = $read.itemCount
        validItemCount   = $validItemCount
        invalidItemCount = $invalidItemCount
        itemResults      = $itemResults
        warnings         = @($warnings)
        errors           = @($errors)
        items            = @($read.items)
    }
}

function Test-UckkOpsMoodleDataItem {
    [CmdletBinding()]
    param(
        [Parameter()]
        [object] $Item,

        [Parameter(Mandatory)]
        [int] $Index,

        [Parameter(Mandatory)]
        [object] $Definition
    )

    $warnings = @()
    $errors = @()

    if (-not $Item) {
        $errors += "$($Definition.label) item #$Index : élément vide."
        return [pscustomobject]@{
            index    = $Index
            ok       = $false
            key      = ""
            warnings = @($warnings)
            errors   = @($errors)
        }
    }

    $stableKey = Get-UckkOpsMoodleDataStableKey `
        -Item $Item `
        -Definition $Definition

    if (-not $stableKey.value) {
        $errors += "$($Definition.label) item #$Index : identifiant stable absent. Champs possibles : $($Definition.stableKeys -join ', ')."
    }

    foreach ($field in $Definition.requiredFields) {
        $value = Get-UckkOpsObjectValue -Object $Item -Name $field -Default $null

        if ($null -eq $value -or [string]::IsNullOrWhiteSpace([string] $value)) {
            $errors += "$($Definition.label) item #$Index : champ obligatoire absent ou vide : $field."
        }
    }

    foreach ($property in @("password", "passwd", "token", "secret", "apikey", "api_key", "private_key", "cookie", "session")) {
        if ($Item.PSObject.Properties.Name -contains $property) {
            $errors += "$($Definition.label) item #$Index : champ sensible interdit dans les fichiers Données Moodle : $property."
        }
    }

    return [pscustomobject]@{
        index    = $Index
        ok       = ($errors.Count -eq 0)
        key      = $stableKey.value
        keyField = $stableKey.field
        warnings = @($warnings)
        errors   = @($errors)
    }
}

function Test-UckkOpsMoodleDataDuplicateKeys {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object[]] $Items,

        [Parameter(Mandatory)]
        [object] $Definition
    )

    $warnings = @()
    $errors = @()
    $seen = @{}

    $index = 0

    foreach ($item in $Items) {
        $index++

        $stableKey = Get-UckkOpsMoodleDataStableKey `
            -Item $item `
            -Definition $Definition

        if (-not $stableKey.value) {
            continue
--- CHUNK END ---

        }

        $compound = "$($stableKey.field):$($stableKey.value)".ToLowerInvariant()

        if ($seen.ContainsKey($compound)) {
            $errors += "$($Definition.label) : doublon détecté pour $compound aux items #$($seen[$compound]) et #$index."
        }
        else {
            $seen[$compound] = $index
        }
    }

    return [pscustomobject]@{
        ok       = ($errors.Count -eq 0)
        warnings = @($warnings)
        errors   = @($errors)
    }
}

function Test-UckkOpsMoodleDataDependencies {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object[]] $DomainResults
    )

    $warnings = @()
    $errors = @()

    $byDomain = @{}

    foreach ($result in $DomainResults) {
        $byDomain[$result.domain] = $result
    }

    foreach ($result in $DomainResults) {
        $definition = Get-UckkOpsMoodleDataDomainDefinition -Domain $result.domain

        foreach ($rule in @($definition.dependencyRules)) {
            if (-not $byDomain.ContainsKey($rule.dependsOn)) {
                if ($rule.required) {
                    $errors += "$($definition.label) : dépendance requise absente du lot de validation : $($rule.dependsOn)."
                }
                else {
                    $warnings += "$($definition.label) : dépendance non validée : $($rule.dependsOn)."
                }

                continue
            }

            $dependencyIndex = New-UckkOpsMoodleDataDependencyIndex `
                -DomainResult $byDomain[$rule.dependsOn] `
                -Keys $rule.dependsOnKey

            $itemIndex = 0

            foreach ($item in @($result.items)) {
                $itemIndex++
                $value = Get-UckkOpsObjectValue -Object $item -Name $rule.field -Default $null

                if ($null -eq $value -or [string]::IsNullOrWhiteSpace([string] $value)) {
                    if ($rule.required) {
                        $errors += "$($definition.label) item #$itemIndex : dépendance obligatoire absente : $($rule.label)."
                    }

                    continue
                }

                $lookup = ([string] $value).Trim().ToLowerInvariant()

                if (-not $dependencyIndex.ContainsKey($lookup)) {
                    $errors += "$($definition.label) item #$itemIndex : $($rule.label) introuvable : $value."
                }
            }
        }
    }

    return [pscustomobject]@{
        ok       = ($errors.Count -eq 0)
        warnings = @($warnings)
        errors   = @($errors)
    }
}

# ---------------------------------------------------------------------------
# Public: indexes for apply/simulation modules
# ---------------------------------------------------------------------------

function New-UckkOpsMoodleDataStableIndex {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object[]] $Items,

        [Parameter(Mandatory)]
        [string] $Domain
    )

    $definition = Get-UckkOpsMoodleDataDomainDefinition -Domain $Domain
    $index = @{}

    foreach ($item in $Items) {
        $stableKey = Get-UckkOpsMoodleDataStableKey `
            -Item $item `
            -Definition $definition

        if (-not $stableKey.value) {
            continue
        }

        $compound = "$($stableKey.field):$($stableKey.value)".ToLowerInvariant()
        $index[$compound] = $item
    }

    return $index
}

function Get-UckkOpsMoodleDataStableKey {
    [CmdletBinding()]
    param(
        [Parameter()]
        [object] $Item,

        [Parameter(Mandatory)]
        [object] $Definition
    )

    if (-not $Item) {
        return [pscustomobject]@{
            field = ""
            value = ""
        }
    }

    foreach ($keyName in $Definition.stableKeys) {
        $value = Get-UckkOpsObjectValue -Object $Item -Name $keyName -Default $null

        if ($null -ne $value -and -not [string]::IsNullOrWhiteSpace([string] $value)) {
            return [pscustomobject]@{
                field = $keyName
                value = ([string] $value).Trim()
            }
        }
    }

    return [pscustomobject]@{
        field = ""
        value = ""
    }
}

# ---------------------------------------------------------------------------
# Private helpers
# ---------------------------------------------------------------------------

function New-UckkOpsMoodleDataDependencyIndex {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $DomainResult,

        [Parameter(Mandatory)]
        [string[]] $Keys
    )

    $index = @{}

    foreach ($item in @($DomainResult.items)) {
        foreach ($key in $Keys) {
            $value = Get-UckkOpsObjectValue -Object $item -Name $key -Default $null

            if ($null -ne $value -and -not [string]::IsNullOrWhiteSpace([string] $value)) {
                $index[([string] $value).Trim().ToLowerInvariant()] = $true
            }
        }
    }

    return $index
}

function Get-UckkOpsNestedValue {
    [CmdletBinding()]
    param(
        [Parameter()]
        [object] $Object,

        [Parameter(Mandatory)]
        [string] $Name,

        [Parameter()]
        [object] $Default = $null
    )

    if (-not $Object) {
        return $Default
    }

    $current = $Object

    foreach ($part in $Name.Split(".")) {
        if (-not $current) {
            return $Default
        }

        if ($current -is [hashtable]) {
            if ($current.ContainsKey($part)) {
                $current = $current[$part]
                continue
            }

            return $Default
        }

        if ($current -is [System.Collections.IDictionary]) {
            if ($current.Contains($part)) {
                $current = $current[$part]
                continue
            }

            return $Default
        }

        if ($current.PSObject.Properties.Name -contains $part) {
            $current = $current.$part
            continue
        }

        return $Default
    }

    return $current
}

function Get-UckkOpsObjectValue {
    [CmdletBinding()]
    param(
        [Parameter()]
        [object] $Object,

        [Parameter(Mandatory)]
        [string] $Name,

        [Parameter()]
        [object] $Default = $null
    )

    if (-not $Object) {
        return $Default
    }

    if ($Object -is [hashtable]) {
        if ($Object.ContainsKey($Name)) {
            return $Object[$Name]
        }

        return $Default
    }

    if ($Object -is [System.Collections.IDictionary]) {
        if ($Object.Contains($Name)) {
            return $Object[$Name]
        }

        return $Default
    }

    if ($Object.PSObject.Properties.Name -contains $Name) {
        return $Object.$Name
    }

    return $Default
}

function Test-UckkOpsLocalPathLike {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $Path
    )

    return ($Path -match '^[A-Za-z]:[\\/]' -or $Path -match '^\\\\')
}

function Test-UckkOpsServerPathLike {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $Path
    )

    return ($Path.StartsWith("/") -and -not (Test-UckkOpsLocalPathLike -Path $Path))
}

function Test-UckkOpsUrlLike {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $Value
    )

    return ($Value -match '^[a-zA-Z][a-zA-Z0-9+.-]*://')
}

function Normalize-UckkOpsJsonLocalPath {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $Path,

        [Parameter()]
        [switch] $AllowMissing
    )

    $pathModuleCommand = Get-Command -Name "Normalize-UckkOpsLocalPath" -ErrorAction SilentlyContinue

    if ($pathModuleCommand) {
        return Normalize-UckkOpsLocalPath -Path $Path -AllowMissing:$AllowMissing
    }

    $expanded = [Environment]::ExpandEnvironmentVariables($Path.Trim())

    if (Test-Path -LiteralPath $expanded) {
        return (Resolve-Path -LiteralPath $expanded).Path
    }

    if ($AllowMissing) {
        return [System.IO.Path]::GetFullPath($expanded)
    }

    throw "Chemin introuvable : $expanded"
}

function Join-UckkOpsJsonLocalPath {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $BasePath,

        [Parameter(Mandatory)]
        [string] $ChildPath
    )

    $pathModuleCommand = Get-Command -Name "Join-UckkOpsLocalPath" -ErrorAction SilentlyContinue

    if ($pathModuleCommand) {
        return Join-UckkOpsLocalPath -BasePath $BasePath -ChildPath @($ChildPath)
    }

    return [System.IO.Path]::GetFullPath((Join-Path -Path $BasePath -ChildPath $ChildPath))
}
