function Get-UckkLocalBaseUri {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $BaseUrl
    )

    try {
        $uri = [System.Uri]::new($BaseUrl)
    }
    catch {
        throw "URL locale invalide : $BaseUrl"
    }

    if ($uri.Scheme -ne 'http' -and $uri.Scheme -ne 'https') {
        throw "URL locale non supportée : $BaseUrl"
    }

    $port = $uri.Port

    if ($port -lt 1) {
        if ($uri.Scheme -eq 'https') {
            $port = 443
        }
        else {
            $port = 80
        }
    }

    return [pscustomobject]@{
        scheme = $uri.Scheme
        host   = $uri.Host
        port   = $port
        url    = $uri.ToString().TrimEnd('/')
    }
}

function Test-UckkLocalUrlResponding {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $Url,

        [Parameter()]
        [int] $TimeoutSeconds = 5
    )

    try {
        $response = Invoke-WebRequest `
            -Uri $Url `
            -UseBasicParsing `
            -TimeoutSec $TimeoutSeconds `
            -ErrorAction Stop

        return [pscustomobject]@{
            success    = $true
            url        = $Url
            statusCode = $response.StatusCode
            detail     = $response.StatusDescription
        }
    }
    catch {
        return [pscustomobject]@{
            success    = $false
            url        = $Url
            statusCode = $null
            detail     = $_.Exception.Message
        }
    }
}

function Wait-UckkLocalUrlResponding {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $Url,

        [Parameter()]
        [int] $TimeoutSeconds = 60,

        [Parameter()]
        [int] $DelayMilliseconds = 1000,

        [Parameter()]
        [int] $RequestTimeoutSeconds = 5
    )

    $deadline = (Get-Date).AddSeconds($TimeoutSeconds)
    $lastCheck = $null

    do {
        $lastCheck = Test-UckkLocalUrlResponding `
            -Url $Url `
            -TimeoutSeconds $RequestTimeoutSeconds

        if ($lastCheck.success) {
            return $lastCheck
        }

        Start-Sleep -Milliseconds $DelayMilliseconds
    }
    while ((Get-Date) -lt $deadline)

    return $lastCheck
}

function Resolve-UckkLocalOpenUrl {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config,

        [Parameter(Mandatory)]
        [string] $BaseUrl,

        [Parameter()]
        [string] $Path = '/'
    )

    $normalizedPath = [string] $Path

    if ([string]::IsNullOrWhiteSpace($normalizedPath) -or $normalizedPath -eq '/') {
        return ($BaseUrl.TrimEnd('/') + '/')
    }

    if ($normalizedPath -match '^https?://') {
        return $normalizedPath
    }

    return Join-UckkLocalUrl -BaseUrl $BaseUrl -Path $normalizedPath
}

function Start-UckkLocalDetachedProcess {
