function Test-UckkLocalSyncExcluded {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $RelativePath
    )

    $normalized = $RelativePath.Replace('\', '/')

    $excludedRootNames = @(
        '.git',
        '.github',
        '.idea',
        '.vscode',
        'node_modules',
        'reports',
        'logs',
        'legacy',
        'recovery',
        'backups',
        'tmp',
        'temp'
    )

    foreach ($name in $excludedRootNames) {
        if ($normalized -eq $name -or $normalized.StartsWith("$name/")) {
            return $true
        }
    }

    $leaf = [System.IO.Path]::GetFileName($RelativePath)

    # .env reste toujours exclu, quel que soit son emplacement.
    if ($leaf -eq '.env') {
        return $true
    }

    # Ne protéger que le config.php à la RACINE de la source.
    # Les config.php imbriqués sont indispensables aux plugins/thèmes Moodle,
    # par ex. theme/uckk/config.php, theme/ucmath/config.php, etc.
    if ($normalized -eq 'config.php') {
        return $true
    }

    $excludedExtensions = @(
        '.sql',
        '.bak',
        '.backup',
        '.dump',
        '.zip',
        '.7z',
        '.rar',
        '.log',
        '.tmp'
    )

    $extension = [System.IO.Path]::GetExtension($leaf)

    if ($excludedExtensions -contains $extension) {
        return $true
    }

    return $false
}

function Copy-UckkLocalTree {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $SourceDir,

        [Parameter(Mandatory)]
        [string] $TargetDir,

        [Parameter()]
        [switch] $Simulation
    )

    $sourceFull = ConvertTo-UckkLocalFullPath -Path $SourceDir
    $targetFull = ConvertTo-UckkLocalFullPath -Path $TargetDir

    $files = Get-ChildItem -LiteralPath $sourceFull -Recurse -File -Force

    $copied = 0
    $skipped = 0
    $failed = 0
    $failures = [System.Collections.Generic.List[string]]::new()

    foreach ($file in $files) {
        $relative = [System.IO.Path]::GetRelativePath($sourceFull, $file.FullName)

        if (Test-UckkLocalSyncExcluded -RelativePath $relative) {
            $skipped++
            continue
        }

        $destination = Join-Path $targetFull $relative
        $destinationDir = Split-Path -Parent $destination

        try {
            if (-not $Simulation) {
                if (-not (Test-Path -LiteralPath $destinationDir)) {
                    New-Item -ItemType Directory -Path $destinationDir -Force | Out-Null
                }

                Copy-Item `
                    -LiteralPath $file.FullName `
                    -Destination $destination `
                    -Force
            }

            $copied++
        }
        catch {
            $failed++
            $failures.Add("$relative — $($_.Exception.Message)")
        }
    }

    return [pscustomobject]@{
        source       = $sourceFull
        target       = $targetFull

        simulation   = [bool] $Simulation
        copied       = $copied
        skipped      = $skipped
        failed       = $failed
        failureItems = $failures
    }
}

