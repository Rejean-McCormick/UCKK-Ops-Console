function Test-UckkLocalPaths {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config
    )

    $action = 'Vérifier les chemins locaux'

    $result = New-UckkLocalResult `
        -Action $action `
        -Target 'local' `
        -DangerLevel 1 `
        -Mode 'vérification' `
        -Status 'En cours' `
        -Summary 'Vérification des chemins locaux en cours.'

    $checks = [System.Collections.Generic.List[object]]::new()

    $items = @(
        @{ label = 'Racine de l application'; path = 'app.root'; required = $false; type = 'directory' },
        @{ label = 'Source Git locale'; path = 'paths.uckkMoodleSource'; required = $true; type = 'directory' },
        @{ label = 'Moodle local'; path = 'paths.localMoodleRoot'; required = $true; type = 'directory' },
        @{ label = 'Dossier exécuté par Moodle local'; path = 'paths.localMoodleRuntime'; required = $true; type = 'directory' },
        @{ label = 'Dossier des rapports'; path = 'reports.dir'; required = $false; type = 'directory' },
        @{ label = 'Dossier des logs'; path = 'logs.dir'; required = $false; type = 'directory' }
    )

    foreach ($item in $items) {
        try {
            $value = Get-UckkLocalConfigValue `
                -Config $Config `
                -Path $item.path `
                -Required:([bool] $item.required)

            if ($null -eq $value -or [string]::IsNullOrWhiteSpace([string] $value)) {
                $checks.Add([pscustomobject]@{
                    label  = $item.label
                    key    = $item.path
                    path   = ''
                    exists = $false
                    status = 'Ignoré'
                    detail = 'Non configuré.'
                })

                continue
            }

            $fullPath = ConvertTo-UckkLocalFullPath -Path ([string] $value)
            $exists = Test-Path -LiteralPath $fullPath

            $checks.Add([pscustomobject]@{
                label  = $item.label
                key    = $item.path
                path   = $fullPath
                exists = $exists
                status = $(if ($exists) { 'Réussi' } else { 'Échoué' })
                detail = $(if ($exists) { 'Chemin trouvé.' } else { 'Chemin introuvable.' })
            })

            if ($exists) {
                $result = Add-UckkLocalStep -Result $result -Step (
                    New-UckkLocalStep `
                        -Name $item.label `
                        -Status 'Réussi' `
                        -Summary 'Chemin trouvé.' `
                        -Detail $fullPath
                )
            }

            else {
                $result = Add-UckkLocalStep -Result $result -Step (
                    New-UckkLocalStep `
                        -Name $item.label `
                        -Status 'Échoué' `
                        -Summary 'Chemin introuvable.' `
                        -Detail $fullPath
                )

                if ($item.required) {
                    $result = Add-UckkLocalError -Result $result -ErrorMessage "$($item.label) introuvable : $fullPath"
                }
                else {
                    $result = Add-UckkLocalWarning -Result $result -Warning "$($item.label) introuvable : $fullPath"
                }
            }
        }
        catch {
            $message = $_.Exception.Message

            $checks.Add([pscustomobject]@{
                label  = $item.label
                key    = $item.path
                path   = ''
                exists = $false
                status = 'Échoué'
                detail = $message
            })

            $result = Add-UckkLocalError -Result $result -ErrorMessage $message
            $result = Add-UckkLocalStep -Result $result -Step (
                New-UckkLocalStep `
                    -Name $item.label `
                    -Status 'Échoué' `
                    -Summary $message
            )
        }
    }

    try {
        $localUrl = Get-UckkLocalConfigValue -Config $Config -Path 'urls.localBase' -Required

        $checks.Add([pscustomobject]@{
            label  = 'URL locale'
            key    = 'urls.localBase'
            path   = [string] $localUrl
            exists = $true
            status = 'Réussi'
            detail = 'URL configurée.'
        })

        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'URL locale' `
                -Status 'Réussi' `
                -Summary 'URL configurée.' `
                -Detail ([string] $localUrl)
        )
    }
    catch {
        $result = Add-UckkLocalError -Result $result -ErrorMessage $_.Exception.Message
    }

    $result.data = [pscustomobject]@{
        checks = $checks
    }

    if ((Get-UckkLocalResultListCount -Result $result -PropertyName 'errors') -gt 0) {
        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Échoué — un ou plusieurs chemins locaux obligatoires sont absents.' `
            -NextStep 'Corriger la configuration ou créer les dossiers nécessaires.'
    }

    if ((Get-UckkLocalResultListCount -Result $result -PropertyName 'warnings') -gt 0) {
        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Réussi avec avertissements — les chemins locaux obligatoires sont présents.' `
            -NextStep 'Lire les avertissements avant de continuer.'
    }

    return Complete-UckkLocalResult `
        -Result $result `
        -Summary 'Réussi — les chemins locaux obligatoires sont présents.' `
        -NextStep 'Synchroniser source vers Moodle local si nécessaire.'
}

function Sync-UckkSourceToLocalMoodle {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config,

        [Parameter()]
        [switch] $Simulation
    )

    $action = $(if ($Simulation) { 'Simulation synchronisation source vers Moodle local' } else { 'Synchroniser source vers Moodle local' })

    $result = New-UckkLocalResult `
        -Action $action `
        -Target 'dossier exécuté par Moodle local' `
        -DangerLevel 2 `
        -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
        -Status 'En cours' `
        -Summary 'Synchronisation locale en cours.'

    try {
        $source = ConvertTo-UckkLocalFullPath -Path (
            Get-UckkLocalConfigValue -Config $Config -Path 'paths.uckkMoodleSource' -Required
        )

        $localMoodleRoot = ConvertTo-UckkLocalFullPath -Path (
            Get-UckkLocalConfigValue -Config $Config -Path 'paths.localMoodleRoot' -Required
        )

        $target = ConvertTo-UckkLocalFullPath -Path (
            Get-UckkLocalConfigValue -Config $Config -Path 'paths.localMoodleRuntime' -Required
        )
    }
    catch {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'dossier exécuté par Moodle local' `
            -DangerLevel 2 `
            -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
            -Cause $_.Exception.Message `
            -NextStep 'Corriger la configuration des chemins locaux.'
    }

    if (-not (Test-Path -LiteralPath $source -PathType Container)) {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'dossier exécuté par Moodle local' `
            -DangerLevel 2 `
            -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
            -Cause "Source locale introuvable : $source" `
            -NextStep 'Vérifier paths.uckkMoodleSource.'
    }

    if (-not (Test-Path -LiteralPath $target -PathType Container)) {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'dossier exécuté par Moodle local' `
            -DangerLevel 2 `
            -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
            -Cause "Dossier exécuté par Moodle local introuvable : $target" `
            -NextStep 'Vérifier paths.localMoodleRuntime.'
    }

    if (-not (Test-UckkLocalPathInside -ChildPath $target -ParentPath $localMoodleRoot)) {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'dossier exécuté par Moodle local' `
            -DangerLevel 2 `
            -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
            -Cause "La cible locale n est pas située dans le Moodle local configuré : $target" `
            -NextStep 'Vérifier paths.localMoodleRoot et paths.localMoodleRuntime.'
    }

    if ($source -eq $target) {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'dossier exécuté par Moodle local' `
            -DangerLevel 2 `
            -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
            -Cause 'La source et la cible sont identiques.' `
            -NextStep 'Corriger la configuration avant de synchroniser.'
    }

    $result = Add-UckkLocalStep -Result $result -Step (
        New-UckkLocalStep `
            -Name 'Vérifier source locale' `
            -Status 'Réussi' `
            -Summary 'Source locale trouvée.' `
            -Detail $source
    )

    $result = Add-UckkLocalStep -Result $result -Step (
        New-UckkLocalStep `
            -Name 'Vérifier cible Moodle locale' `
            -Status 'Réussi' `
-Summary 'Cible locale trouvée.' `
            -Detail $target
    )

    try {
        $copyResult = Copy-UckkLocalTree `
            -SourceDir $source `
            -TargetDir $target `
            -Simulation:$Simulation

        $result.data = $copyResult

        if ($copyResult.failed -gt 0) {
            foreach ($failure in $copyResult.failureItems) {
                $result = Add-UckkLocalError -Result $result -ErrorMessage $failure
            }

            $result = Add-UckkLocalStep -Result $result -Step (
                New-UckkLocalStep `
                    -Name 'Copier fichiers' `
                    -Status 'Échoué' `
                    -Summary "$($copyResult.failed) fichier(s) en échec." `
                    -Data $copyResult
            )

            return Complete-UckkLocalResult `
                -Result $result `
                -Summary 'Échoué — la synchronisation locale n est pas complète.' `
                -NextStep 'Lire les erreurs, corriger les fichiers concernés, puis relancer.'
        }

        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name $(if ($Simulation) { 'Simuler copie fichiers' } else { 'Copier fichiers' }) `
                -Status 'Réussi' `
                -Summary "$($copyResult.copied) fichier(s) traité(s), $($copyResult.skipped) ignoré(s)." `
                -Data $copyResult
        )

        if ($Simulation) {
            return Complete-UckkLocalResult `
                -Result $result `
                -Summary "Réussi — simulation terminée. Aucune donnée locale n a été modifiée. $($copyResult.copied) fichier(s) seraient copiés, $($copyResult.skipped) ignoré(s)." `
                -NextStep 'Lancer "Synchroniser source vers Moodle local" si tout est correct.'
        }

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary "Réussi — la source a été copiée vers Moodle local. $($copyResult.copied) fichier(s) copiés, $($copyResult.skipped) ignoré(s)." `
            -NextStep 'Purger les caches locaux, puis ouvrir Moodle local.'
    }
    catch {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'dossier exécuté par Moodle local' `
            -DangerLevel 2 `
            -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
            -Cause $_.Exception.Message `
            -NextStep 'Lire le détail technique et corriger la cause.'
    }
}


function Get-UckkLocalMoodleReleaseInfo {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $MoodleRoot
    )

    # Moodle's modern layout keeps web-facing core files under public/, while
    # CLI scripts such as admin/cli/upgrade.php remain under the code root.
    # Support both the modern and legacy layouts.
    $versionCandidates = @(
        (Join-Path $MoodleRoot 'public\version.php'),
        (Join-Path $MoodleRoot 'version.php')
    ) | Select-Object -Unique

    $versionFile = $versionCandidates | Where-Object { Test-Path -LiteralPath $_ -PathType Leaf } | Select-Object -First 1

    $info = [ordered]@{
        success      = $false
        versionFile  = $(if ($versionFile) { $versionFile } else { $versionCandidates[0] })
        versionFileCandidates = @($versionCandidates)
        version      = ''
        release      = ''
        branch       = ''
        maturity     = ''
        isUnstable   = $false
        allowUnstableRequired = $false
        parseMethod  = 'line-assignment'
        parseError   = ''
    }

    if (-not $versionFile) {
        $info.parseError = 'Aucun version.php core trouvé dans public/version.php ou version.php.'
        return [pscustomobject] $info
    }

    try {
        $lines = @(Get-Content -LiteralPath $versionFile -ErrorAction Stop)

        foreach ($line in $lines) {
            $trimmed = ([string]$line).Trim()
            if ([string]::IsNullOrWhiteSpace($trimmed) -or $trimmed.StartsWith('//') -or $trimmed.StartsWith('#')) {
                continue
            }

            $name = $null
            if ($trimmed.StartsWith('$version') -and $trimmed.Contains('=')) {
                $name = 'version'
            }
            elseif ($trimmed.StartsWith('$release') -and $trimmed.Contains('=')) {
                $name = 'release'
            }
            elseif ($trimmed.StartsWith('$branch') -and $trimmed.Contains('=')) {
                $name = 'branch'
            }
            elseif ($trimmed.StartsWith('$maturity') -and $trimmed.Contains('=')) {
                $name = 'maturity'
            }

            if (-not $name) {
                continue
            }

            $parts = $trimmed.Split('=', 2)
            if ($parts.Count -lt 2) {
                continue
            }

            $value = ([string]$parts[1]).Trim()

            # Strip inline PHP comments first, then the terminating semicolon.
            $commentIndex = $value.IndexOf('//')
            if ($commentIndex -ge 0) {
                $value = $value.Substring(0, $commentIndex).Trim()
            }
            if ($value.EndsWith(';')) {
                $value = $value.Substring(0, $value.Length - 1).Trim()
            }

            # Remove matching single/double quotes without fragile quote regexes.
            if ($value.Length -ge 2) {
                $first = [int][char]$value[0]
                $last = [int][char]$value[$value.Length - 1]
                if (($first -eq 39 -and $last -eq 39) -or ($first -eq 34 -and $last -eq 34)) {
                    $value = $value.Substring(1, $value.Length - 2)
                }
            }

            switch ($name) {
                'version'  { $info.version = $value; break }
                'release'  { $info.release = $value; break }
                'branch'   { $info.branch = $value; break }
                'maturity' { $info.maturity = $value; break }
            }
        }

        $unstable = @('MATURITY_ALPHA', 'MATURITY_BETA', 'MATURITY_RC')
        $info.isUnstable = $unstable -contains $info.maturity
        $info.allowUnstableRequired = $info.isUnstable
        $info.success = -not [string]::IsNullOrWhiteSpace($info.version) -or -not [string]::IsNullOrWhiteSpace($info.maturity)

        if (-not $info.success) {
            $info.parseError = 'Aucune affectation $version/$maturity reconnue dans le version.php trouvé.'
        }
    }
    catch {
        $info.success = $false
        $info.parseError = $_.Exception.Message
    }

    return [pscustomobject] $info
}

function Test-UckkLocalMoodleCli {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config
    )

    $action = 'Diagnostiquer Moodle local'

    $result = New-UckkLocalResult `
        -Action $action `
        -Target 'Moodle local' `
        -DangerLevel 1 `
        -Mode 'vérification' `
        -Status 'En cours' `
        -Summary 'Diagnostic de la racine CLI Moodle, de PHP et des scripts admin/cli.'

    try {
        $phpBinary = Get-UckkLocalPhpBinary -Config $Config
        $upgradeRelative = [string](Get-UckkLocalConfigValue -Config $Config -Path 'moodle.upgradeScript' -Default 'admin/cli/upgrade.php')
        $purgeRelative = [string](Get-UckkLocalConfigValue -Config $Config -Path 'moodle.purgeCachesScript' -Default 'admin/cli/purge_caches.php')

        $upgradeContext = Resolve-UckkLocalMoodleCliContext -Config $Config -ScriptRelativePath $upgradeRelative
        $purgeContext = Resolve-UckkLocalMoodleCliContext -Config $Config -ScriptRelativePath $purgeRelative
        $releaseInfo = Get-UckkLocalMoodleReleaseInfo -MoodleRoot $upgradeContext.localMoodleRoot

        $phpCheck = Invoke-UckkLocalProcess `
            -FilePath $phpBinary `
            -ArgumentList @('-v') `
            -WorkingDirectory $upgradeContext.localMoodleRoot `
            -TimeoutSeconds 30
    }
    catch {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'Moodle local' `
            -DangerLevel 1 `
            -Mode 'vérification' `
            -Cause $_.Exception.Message `
            -NextStep 'Corriger paths.localMoodleRoot, paths.localMoodleRuntime ou moodle.localPhpPath.'
    }

    $result = Add-UckkLocalStep -Result $result -Step (
        New-UckkLocalStep `
            -Name 'Vérifier PHP CLI' `
            -Status $(if ($phpCheck.success) { 'Réussi' } else { 'Échoué' }) `
            -Summary $(if ($phpCheck.success) { 'PHP CLI répond.' } else { 'PHP CLI ne répond pas correctement.' }) `
            -Detail (ConvertTo-UckkLocalProcessDetail -ProcessResult $phpCheck) `
            -Data $phpCheck
    )

    if (-not $phpCheck.success) {
        $result = Add-UckkLocalError -Result $result -ErrorMessage "PHP CLI a échoué : $($phpCheck.stderr)"
    }

    $releaseLines = [System.Collections.Generic.List[string]]::new()
    $releaseLines.Add("version.php retenu : $($releaseInfo.versionFile)")
    $releaseLines.Add('version.php testés :')
    foreach ($candidate in @($releaseInfo.versionFileCandidates)) {
        $releaseLines.Add("- $candidate => $(if (Test-Path -LiteralPath $candidate -PathType Leaf) { 'trouvé' } else { 'absent' })")
    }
    $releaseLines.Add("Version : $(if ($releaseInfo.version) { $releaseInfo.version } else { '(non détectée)' })")
    $releaseLines.Add("Release : $(if ($releaseInfo.release) { $releaseInfo.release } else { '(non détectée)' })")
    $releaseLines.Add("Branche : $(if ($releaseInfo.branch) { $releaseInfo.branch } else { '(non détectée)' })")
    $releaseLines.Add("Maturité : $(if ($releaseInfo.maturity) { $releaseInfo.maturity } else { '(non détectée)' })")
    $releaseLines.Add("--allow-unstable requis : $($releaseInfo.allowUnstableRequired)")
    $releaseLines.Add("Méthode de lecture : $($releaseInfo.parseMethod)")
    if ($releaseInfo.parseError) { $releaseLines.Add("Diagnostic lecture : $($releaseInfo.parseError)") }

    $result = Add-UckkLocalStep -Result $result -Step (
        New-UckkLocalStep `
            -Name 'Lire version et maturité Moodle' `
            -Status $(if ($releaseInfo.success) { 'Réussi' } else { 'Réussi avec avertissements' }) `
            -Summary $(if ($releaseInfo.success) { "Maturité Moodle : $($releaseInfo.maturity)" } else { 'version.php non lisible ou maturité non détectée.' }) `
            -Detail ($releaseLines -join [Environment]::NewLine) `
            -Data $releaseInfo
    )

    if ($releaseInfo.isUnstable) {
        $result = Add-UckkLocalWarning `
            -Result $result `
            -Warning "Moodle est marqué $($releaseInfo.maturity). L upgrade CLI exige --allow-unstable. L Ops Console l ajoutera seulement dans l action d upgrade confirmée."
    }

    foreach ($item in @(
        @{ name = 'Résoudre admin/cli/upgrade.php'; context = $upgradeContext },
        @{ name = 'Résoudre admin/cli/purge_caches.php'; context = $purgeContext }
    )) {
        $context = $item.context
        $probeLines = [System.Collections.Generic.List[string]]::new()
        $probeLines.Add("Racine code configurée : $($context.localMoodleRoot)")
        $probeLines.Add("Webroot configuré : $($context.localMoodleRuntime)")
        $probeLines.Add("Script demandé : $($context.scriptRelativePath)")
        $probeLines.Add("Script résolu : $($context.scriptPath)")
        $probeLines.Add('')
        $probeLines.Add('Chemins testés :')

        foreach ($probe in @($context.probes)) {
            $probeLines.Add("- $($probe.script) => $(if ($probe.scriptExists) { 'trouvé' } else { 'absent' })")
        }

        $probeLines.Add('')
        $probeLines.Add('config.php testés :')
        foreach ($probe in @($context.configProbes)) {
            $probeLines.Add("- $($probe.path) => $(if ($probe.exists) { 'trouvé' } else { 'absent' })")
        }

        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name $item.name `
                -Status $(if ($context.success) { 'Réussi' } else { 'Échoué' }) `
                -Summary $(if ($context.success) { "Script trouvé dans $($context.cliRoot)." } else { 'Script Moodle CLI introuvable.' }) `
                -Detail ($probeLines -join [Environment]::NewLine) `
                -Data $context
        )

        if (-not $context.success) {
            $result = Add-UckkLocalError `
                -Result $result `
                -ErrorMessage "Script Moodle CLI introuvable : $($context.scriptRelativePath)."
        }
    }

    $result.data = [pscustomobject]@{
        phpBinary      = $phpBinary
        phpCheck       = $phpCheck
        releaseInfo    = $releaseInfo
        upgradeContext = $upgradeContext
        purgeContext   = $purgeContext
    }

    if ((Get-UckkLocalResultListCount -Result $result -PropertyName 'errors') -gt 0) {
        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Échoué — le diagnostic Moodle local a trouvé un problème de racine CLI, de script admin/cli ou de PHP.' `
            -NextStep 'Lire les étapes détaillées : elles indiquent chaque chemin testé, la commande PHP et le script manquant.'
    }

    if ($upgradeContext.cliRoot -eq $upgradeContext.localMoodleRuntime) {
        $result = Add-UckkLocalWarning `
            -Result $result `
            -Warning 'La racine CLI Moodle est identique au webroot. Cela peut être normal sur une ancienne structure Moodle, mais la configuration actuelle prévoit aussi paths.localMoodleRoot.'
    }

    return Complete-UckkLocalResult `
        -Result $result `
        -Summary "Réussi — Moodle CLI est prêt. Racine CLI : $($upgradeContext.cliRoot)" `
        -NextStep $(if ($releaseInfo.isUnstable) { 'Synchroniser les plugins puis lancer l upgrade confirmé. L Ops Console ajoutera --allow-unstable et le consignera dans le rapport.' } else { 'Synchroniser les plugins puis lancer l upgrade Moodle local.' })
}


function Invoke-UckkLocalMoodleUpgrade {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config,

        [Parameter()]
        [switch] $Confirmed
    )

    $action = 'Mettre à jour Moodle local'

    if (-not $Confirmed) {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'base Moodle locale' `
            -DangerLevel 3 `
            -Mode 'application' `
            -Cause 'Confirmation requise avant un upgrade Moodle local.' `
            -NextStep 'Relancer l action et confirmer la modification potentielle de la base Moodle locale.'
    }

    $result = New-UckkLocalResult `
        -Action $action `
        -Target 'base Moodle locale' `
        -DangerLevel 3 `
        -Mode 'application' `
        -Status 'En cours' `
        -Summary 'Résolution de la racine CLI Moodle puis exécution de l upgrade.'

    try {
        $phpBinary = Get-UckkLocalPhpBinary -Config $Config
        $upgradeRelative = [string](Get-UckkLocalConfigValue -Config $Config -Path 'moodle.upgradeScript' -Default 'admin/cli/upgrade.php')
        $cliContext = Resolve-UckkLocalMoodleCliContext -Config $Config -ScriptRelativePath $upgradeRelative
        $releaseInfo = Get-UckkLocalMoodleReleaseInfo -MoodleRoot $cliContext.localMoodleRoot
    }
    catch {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'base Moodle locale' `
            -DangerLevel 3 `
            -Mode 'application' `
            -Cause $_.Exception.Message `
            -NextStep 'Corriger paths.localMoodleRoot, paths.localMoodleRuntime ou moodle.localPhpPath.'
    }

    $resolutionLines = [System.Collections.Generic.List[string]]::new()
    $resolutionLines.Add("Racine code Moodle : $($cliContext.localMoodleRoot)")
    $resolutionLines.Add("Webroot Moodle : $($cliContext.localMoodleRuntime)")
    $resolutionLines.Add("Script demandé : $upgradeRelative")
    $resolutionLines.Add("Racine CLI retenue : $($cliContext.cliRoot)")
    $resolutionLines.Add("Script retenu : $($cliContext.scriptPath)")
    $resolutionLines.Add("version.php retenu : $($releaseInfo.versionFile)")
    $resolutionLines.Add("Version Moodle : $(if ($releaseInfo.version) { $releaseInfo.version } else { '(non détectée)' })")
    $resolutionLines.Add("Release Moodle : $(if ($releaseInfo.release) { $releaseInfo.release } else { '(non détectée)' })")
    $resolutionLines.Add("Maturité Moodle : $(if ($releaseInfo.maturity) { $releaseInfo.maturity } else { '(non détectée)' })")
    $resolutionLines.Add("--allow-unstable requis : $($releaseInfo.allowUnstableRequired)")
    $resolutionLines.Add("Méthode de lecture version.php : $($releaseInfo.parseMethod)")
    if ($releaseInfo.parseError) { $resolutionLines.Add("Diagnostic lecture version.php : $($releaseInfo.parseError)") }
    $resolutionLines.Add('')
    $resolutionLines.Add('Candidats testés :')
    foreach ($probe in @($cliContext.probes)) {
        $resolutionLines.Add("- $($probe.script) => $(if ($probe.scriptExists) { 'trouvé' } else { 'absent' })")
    }

    $result = Add-UckkLocalStep -Result $result -Step (
        New-UckkLocalStep `
            -Name 'Résoudre racine CLI Moodle' `
            -Status $(if ($cliContext.success) { 'Réussi' } else { 'Échoué' }) `
            -Summary $(if ($cliContext.success) { 'Script upgrade Moodle trouvé.' } else { 'Script upgrade Moodle introuvable.' }) `
            -Detail ($resolutionLines -join [Environment]::NewLine) `
            -Data $cliContext
    )

    if (-not $cliContext.success) {
        $result = Add-UckkLocalError `
            -Result $result `
            -ErrorMessage "Script Moodle introuvable : $upgradeRelative."

        $result.data = [pscustomobject]@{
            phpBinary = $phpBinary
            cliContext = $cliContext
        }

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Échoué — le script CLI d upgrade Moodle est introuvable.' `
            -NextStep 'Lancer "Diagnostiquer Moodle local" et vérifier la séparation paths.localMoodleRoot / paths.localMoodleRuntime.'
    }

    $upgradeArgs = [System.Collections.Generic.List[string]]::new()
    $upgradeArgs.Add($cliContext.scriptPath)
    $upgradeArgs.Add('--non-interactive')

    if ($releaseInfo.isUnstable) {
        $upgradeArgs.Add('--allow-unstable')
        $result = Add-UckkLocalWarning `
            -Result $result `
            -Warning "Moodle est marqué $($releaseInfo.maturity). --allow-unstable a été ajouté à cette exécution confirmée."

        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'Autoriser version Moodle instable' `
                -Status 'Réussi avec avertissements' `
                -Summary "Option --allow-unstable ajoutée car la maturité est $($releaseInfo.maturity)." `
                -Detail 'Cette option est limitée à cette commande locale et ne modifie aucune politique globale.' `
                -Data $releaseInfo
        )
    }

    $processResult = Invoke-UckkLocalProcess `
        -FilePath $phpBinary `
        -ArgumentList @($upgradeArgs) `
        -WorkingDirectory $cliContext.cliRoot `
        -TimeoutSeconds 600

    $processDetail = ConvertTo-UckkLocalProcessDetail -ProcessResult $processResult

    $result.data = [pscustomobject]@{
        phpBinary = $phpBinary
        cliContext = $cliContext
        releaseInfo = $releaseInfo
        upgradeArguments = @($upgradeArgs)
        process = $processResult
    }

    $result = Add-UckkLocalStep -Result $result -Step (
        New-UckkLocalStep `
            -Name 'Exécuter upgrade Moodle local' `
            -Status $(if ($processResult.success) { 'Réussi' } else { 'Échoué' }) `
            -Summary $(if ($processResult.success) { 'Upgrade Moodle local terminé.' } else { 'La commande d upgrade Moodle local a échoué.' }) `
            -Detail $processDetail `
            -Data $processResult
    )

    if (-not $processResult.success) {
        $stderr = [string]$processResult.stderr
        $stdout = [string]$processResult.stdout
        $combinedOutput = ($stderr + [Environment]::NewLine + $stdout)
        $requiresAllowUnstable = $combinedOutput -match '--allow-unstable'

        # Safety fallback: Moodle itself can be more authoritative than our version.php parser.
        # If the already-confirmed upgrade exits before migration and explicitly instructs us to
        # use --allow-unstable, retry exactly once with that option and record both attempts.
        if ($requiresAllowUnstable -and -not (@($upgradeArgs) -contains '--allow-unstable')) {
            $result = Add-UckkLocalWarning `
                -Result $result `
                -Warning 'Moodle a explicitement demandé --allow-unstable. Le premier essai a été refusé avant migration; l Ops Console réessaie une seule fois avec cette option dans la même action confirmée.'

            $result = Add-UckkLocalStep -Result $result -Step (
                New-UckkLocalStep `
                    -Name 'Détecter exigence --allow-unstable' `
                    -Status 'Réussi avec avertissements' `
                    -Summary 'Le CLI Moodle a demandé --allow-unstable.' `
                    -Detail (ConvertTo-UckkLocalProcessDetail -ProcessResult $processResult) `
                    -Data $processResult
            )

            $retryArgs = [System.Collections.Generic.List[string]]::new()
            foreach ($arg in @($upgradeArgs)) { $retryArgs.Add([string]$arg) }
            $retryArgs.Add('--allow-unstable')

            $retryResult = Invoke-UckkLocalProcess `
                -FilePath $phpBinary `
                -ArgumentList @($retryArgs) `
                -WorkingDirectory $cliContext.cliRoot `
                -TimeoutSeconds 600

            $result = Add-UckkLocalStep -Result $result -Step (
                New-UckkLocalStep `
                    -Name 'Réessayer upgrade avec --allow-unstable' `
                    -Status $(if ($retryResult.success) { 'Réussi avec avertissements' } else { 'Échoué' }) `
                    -Summary $(if ($retryResult.success) { 'Upgrade Moodle local terminé avec --allow-unstable.' } else { 'Le second essai avec --allow-unstable a échoué.' }) `
                    -Detail (ConvertTo-UckkLocalProcessDetail -ProcessResult $retryResult) `
                    -Data $retryResult
            )

            $result.data = [pscustomobject]@{
                phpBinary = $phpBinary
                cliContext = $cliContext
                releaseInfo = $releaseInfo
                firstUpgradeArguments = @($upgradeArgs)
                firstProcess = $processResult
                retryUpgradeArguments = @($retryArgs)
                retryProcess = $retryResult
                allowUnstableFallbackUsed = $true
            }

            if ($retryResult.success) {
                return Complete-UckkLocalResult `
                    -Result $result `
                    -Summary "Réussi avec avertissements — Moodle local est à jour après réessai avec --allow-unstable. Racine CLI : $($cliContext.cliRoot)" `
                    -NextStep 'Purger les caches locaux puis démarrer Moodle local.'
            }

            $retryErr = [string]$retryResult.stderr
            $retryOut = [string]$retryResult.stdout
            $retryDetail = if (-not [string]::IsNullOrWhiteSpace($retryErr)) { $retryErr.Trim() } elseif (-not [string]::IsNullOrWhiteSpace($retryOut)) { $retryOut.Trim() } else { 'Aucune sortie fournie par PHP.' }
            $result = Add-UckkLocalError -Result $result -ErrorMessage "Upgrade Moodle local avec --allow-unstable échoué (exit=$($retryResult.exitCode)) : $retryDetail"

            return Complete-UckkLocalResult `
                -Result $result `
                -Summary "Échoué — même le réessai avec --allow-unstable a échoué. Commande : $($retryResult.commandLine)" `
                -NextStep 'Lire STDERR/STDOUT du second essai dans les étapes détaillées ou ouvrir le rapport/log technique.'
        }

        $primaryDetail = if (-not [string]::IsNullOrWhiteSpace($stderr)) { $stderr.Trim() } elseif (-not [string]::IsNullOrWhiteSpace($stdout)) { $stdout.Trim() } else { 'Aucune sortie fournie par PHP.' }

        $result = Add-UckkLocalError `
            -Result $result `
            -ErrorMessage "Upgrade Moodle local échoué (exit=$($processResult.exitCode)) : $primaryDetail"

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary "Échoué — Moodle local n a pas été mis à jour. Commande : $($processResult.commandLine)" `
            -NextStep 'Lire STDERR/STDOUT affichés ci-dessous ou ouvrir le rapport/log technique, corriger la cause, puis relancer.'
    }

    return Complete-UckkLocalResult `
        -Result $result `
        -Summary "Réussi — Moodle local est à jour. Racine CLI utilisée : $($cliContext.cliRoot)" `
        -NextStep 'Purger les caches locaux puis démarrer Moodle local.'
}

function Clear-UckkLocalMoodleCaches {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config,

        [Parameter()]
        [switch] $Simulation
    )

    $action = $(if ($Simulation) { 'Simulation purge caches locaux' } else { 'Purger les caches locaux' })

    $result = New-UckkLocalResult `
        -Action $action `
        -Target 'Moodle local' `
        -DangerLevel 2 `
        -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
        -Status 'En cours' `
        -Summary 'Résolution de la racine CLI Moodle pour la purge des caches.'

    try {
        $phpBinary = Get-UckkLocalPhpBinary -Config $Config
        $purgeRelative = [string](Get-UckkLocalConfigValue -Config $Config -Path 'moodle.purgeCachesScript' -Default 'admin/cli/purge_caches.php')
        $cliContext = Resolve-UckkLocalMoodleCliContext -Config $Config -ScriptRelativePath $purgeRelative
    }
    catch {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'Moodle local' `
            -DangerLevel 2 `
            -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
            -Cause $_.Exception.Message `
            -NextStep 'Corriger la configuration Moodle locale.'
    }

    $resolutionLines = [System.Collections.Generic.List[string]]::new()
    $resolutionLines.Add("Racine code Moodle : $($cliContext.localMoodleRoot)")
    $resolutionLines.Add("Webroot Moodle : $($cliContext.localMoodleRuntime)")
    $resolutionLines.Add("Script demandé : $purgeRelative")
    $resolutionLines.Add("Racine CLI retenue : $($cliContext.cliRoot)")
    $resolutionLines.Add("Script retenu : $($cliContext.scriptPath)")
    $resolutionLines.Add('')
    $resolutionLines.Add('Candidats testés :')
    foreach ($probe in @($cliContext.probes)) {
        $resolutionLines.Add("- $($probe.script) => $(if ($probe.scriptExists) { 'trouvé' } else { 'absent' })")
    }

    $result = Add-UckkLocalStep -Result $result -Step (
        New-UckkLocalStep `
            -Name 'Résoudre racine CLI Moodle' `
            -Status $(if ($cliContext.success) { 'Réussi' } else { 'Échoué' }) `
            -Summary $(if ($cliContext.success) { 'Script de purge Moodle trouvé.' } else { 'Script de purge Moodle introuvable.' }) `
            -Detail ($resolutionLines -join [Environment]::NewLine) `
            -Data $cliContext
    )

    if (-not $cliContext.success) {
        $result = Add-UckkLocalError `
            -Result $result `
            -ErrorMessage "Script Moodle introuvable : $purgeRelative."

        $result.data = [pscustomobject]@{
            phpBinary = $phpBinary
            cliContext = $cliContext
        }

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Échoué — le script CLI de purge Moodle est introuvable.' `
            -NextStep 'Lancer "Diagnostiquer Moodle local" puis corriger la racine CLI Moodle.'
    }

    if ($Simulation) {
        $wouldRun = "$phpBinary `"$($cliContext.scriptPath)`""
        $result.data = [pscustomobject]@{
            phpBinary = $phpBinary
            cliContext = $cliContext
            wouldRun = $wouldRun
        }

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary "Réussi — simulation terminée. Commande prévue : $wouldRun" `
            -NextStep 'Lancer "Purger les caches locaux" si tout est correct.'
    }

    $processResult = Invoke-UckkLocalProcess `
        -FilePath $phpBinary `
        -ArgumentList @($cliContext.scriptPath) `
        -WorkingDirectory $cliContext.cliRoot `
        -TimeoutSeconds 180

    $processDetail = ConvertTo-UckkLocalProcessDetail -ProcessResult $processResult

    $result.data = [pscustomobject]@{
        phpBinary = $phpBinary
        cliContext = $cliContext
        process = $processResult
    }

    $result = Add-UckkLocalStep -Result $result -Step (
        New-UckkLocalStep `
            -Name 'Exécuter purge caches' `
            -Status $(if ($processResult.success) { 'Réussi' } else { 'Échoué' }) `
            -Summary $(if ($processResult.success) { 'Caches Moodle locaux purgés.' } else { 'La commande de purge des caches locaux a échoué.' }) `
            -Detail $processDetail `
            -Data $processResult
    )

    if (-not $processResult.success) {
        $stderr = [string]$processResult.stderr
        $stdout = [string]$processResult.stdout
        $primaryDetail = if (-not [string]::IsNullOrWhiteSpace($stderr)) { $stderr.Trim() } elseif (-not [string]::IsNullOrWhiteSpace($stdout)) { $stdout.Trim() } else { 'Aucune sortie fournie par PHP.' }

        $result = Add-UckkLocalError `
            -Result $result `
            -ErrorMessage "Purge caches Moodle échouée (exit=$($processResult.exitCode)) : $primaryDetail"

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary "Échoué — les caches locaux n ont pas été purgés. Commande : $($processResult.commandLine)" `
            -NextStep 'Lire STDERR/STDOUT affichés ci-dessous, corriger la cause, puis relancer.'
    }

    return Complete-UckkLocalResult `
        -Result $result `
        -Summary "Réussi — les caches Moodle locaux ont été purgés. Racine CLI utilisée : $($cliContext.cliRoot)" `
        -NextStep 'Ouvrir Moodle local et vérifier les pages concernées.'
}

function Start-UckkLocalMoodle {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config
    )

    $action = 'Démarrer Moodle local'

    $result = New-UckkLocalResult `
        -Action $action `
        -Target 'Moodle local' `
        -DangerLevel 2 `
        -Mode 'application' `
        -Status 'En cours' `
        -Summary 'Démarrage de Moodle local.'

    try {
        $baseUrl = [string] (
            Get-UckkLocalConfigValue `
                -Config $Config `
                -Path 'urls.localBase' `
                -Required
        )

        $localRuntime = ConvertTo-UckkLocalFullPath -Path (
            Get-UckkLocalConfigValue `
                -Config $Config `
                -Path 'paths.localMoodleRuntime' `
                -Required
        )

        $phpBinary = Get-UckkLocalPhpBinary -Config $Config
        $baseUri = Get-UckkLocalBaseUri -BaseUrl $baseUrl
    }
    catch {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'Moodle local' `
            -DangerLevel 2 `
            -Mode 'application' `
            -Cause $_.Exception.Message `
            -NextStep 'Corriger urls.localBase, paths.localMoodleRuntime ou moodle.localPhpPath.'
    }

    if (-not (Test-Path -LiteralPath $localRuntime -PathType Container)) {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'Moodle local' `
            -DangerLevel 2 `
            -Mode 'application' `
            -Cause "Dossier exécuté par Moodle local introuvable : $localRuntime" `
            -NextStep 'Corriger paths.localMoodleRuntime.'
    }

    $alreadyRunning = Test-UckkLocalUrlResponding `
        -Url $baseUrl `
        -TimeoutSeconds 5

    if ($alreadyRunning.success) {
        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'Vérifier Moodle local' `
                -Status 'Réussi' `
                -Summary 'Moodle local répond déjà.' `
                -Detail $baseUrl `
                -Data $alreadyRunning
        )

        $result.data = [pscustomobject]@{
            baseUrl      = $baseUrl
            localRuntime = $localRuntime
            phpBinary    = $phpBinary
            alreadyReady = $true
            check        = $alreadyRunning
        }

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary "Réussi — Moodle local répond déjà : $baseUrl" `
            -NextStep 'Ouvrir Moodle local ou tester les pages locales.'
    }

    $listenAddress = '{0}:{1}' -f $baseUri.host, $baseUri.port
    $arguments = @(
        '-S',
        $listenAddress,
        '-t',
        $localRuntime
    )

    try {
        $process = Start-UckkLocalDetachedProcess `
            -FilePath $phpBinary `
            -ArgumentList $arguments `
            -WorkingDirectory $localRuntime

        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'Lancer serveur PHP local' `
                -Status 'Réussi' `
                -Summary 'Serveur PHP local lancé.' `
                -Detail "$phpBinary $($arguments -join ' ')" `
                -Data @{
                    processId = $process.Id
                    runtime   = $localRuntime
                    baseUrl   = $baseUrl
                }
        )

        $readyCheck = Wait-UckkLocalUrlResponding `
            -Url $baseUrl `
            -TimeoutSeconds 60 `
            -DelayMilliseconds 1000 `
            -RequestTimeoutSeconds 5

        $result.data = [pscustomobject]@{
            baseUrl      = $baseUrl
            localRuntime = $localRuntime
            phpBinary    = $phpBinary
            arguments    = $arguments
            processId    = $process.Id
            readyCheck   = $readyCheck
        }

        if (-not $readyCheck.success) {
            $result = Add-UckkLocalStep -Result $result -Step (
                New-UckkLocalStep `
                    -Name 'Attendre Moodle local' `
                    -Status 'Réussi avec avertissements' `
                    -Summary 'Moodle local a été lancé, mais peut encore terminer son démarrage.' `
                    -Detail $readyCheck.detail `
                    -Data $readyCheck
            )

            $result = Add-UckkLocalWarning `
                -Result $result `
                -Warning "Moodle local a été lancé, mais ne répondait pas encore pendant la fenêtre d attente : $baseUrl"

            return Complete-UckkLocalResult `
                -Result $result `
                -Summary 'Réussi avec avertissements — Moodle local a été lancé. Il peut prendre quelques secondes avant de répondre.' `
                -NextStep 'Attendre quelques secondes, puis ouvrir Moodle local ou relancer Accueil.'
        }

        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'Attendre Moodle local' `
                -Status 'Réussi' `
                -Summary 'Moodle local répond.' `
                -Detail $baseUrl `
                -Data $readyCheck
        )

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary "Réussi — Moodle local a été démarré et répond : $baseUrl" `
            -NextStep 'Ouvrir Moodle local ou tester les pages locales.'
    }
    catch {
        $result = Add-UckkLocalError -Result $result -ErrorMessage $_.Exception.Message

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Échoué — Moodle local n a pas pu être démarré par l application.' `
            -NextStep 'Vérifier moodle.localPhpPath, le port local et paths.localMoodleRuntime.'
    }
}

function Open-UckkLocalMoodle {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config,

        [Parameter()]
        [string] $Path = '/'
    )

    $action = 'Ouvrir Moodle local'

    try {
        $baseUrl = [string] (Get-UckkLocalConfigValue -Config $Config -Path 'urls.localBase' -Required)

        if ([string]::IsNullOrWhiteSpace($Path) -or $Path -eq '/') {
            $defaultFacadeId = [string](Get-UckkLocalConfigValue -Config $Config -Path 'publicFacades.defaultId' -Default '')

            if (-not [string]::IsNullOrWhiteSpace($defaultFacadeId)) {
                $defaultFacade = Get-UckkLocalPublicFacade -Config $Config -Id $defaultFacadeId
                $defaultTheme = [string](Get-UckkLocalObjectPropertyValue -Object $defaultFacade -Name 'theme' -Default '')

                if (-not [string]::IsNullOrWhiteSpace($defaultTheme)) {
                    $Path = "/?theme=$defaultTheme"
                }
            }
        }

        $url = Resolve-UckkLocalOpenUrl -Config $Config -BaseUrl $baseUrl -Path $Path
    }
    catch {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'Moodle local' `
            -DangerLevel 0 `
            -Mode 'navigation' `
            -Cause $_.Exception.Message `
            -NextStep 'Corriger urls.localBase ou urls.localCourseIndex dans la configuration.'
    }

    $result = New-UckkLocalResult `
        -Action $action `
        -Target 'Moodle local' `
        -DangerLevel 0 `
        -Mode 'navigation' `
        -Status 'En cours' `
        -Summary "Ouverture de l URL locale : $url"

    $baseCheck = Test-UckkLocalUrlResponding `
        -Url $baseUrl `
        -TimeoutSeconds 5

    if (-not $baseCheck.success) {
        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'Vérifier Moodle local' `
                -Status 'Échoué' `
                -Summary 'Moodle local ne répond pas encore.' `
                -Detail $baseCheck.detail `
                -Data $baseCheck
        )

        $startResult = Start-UckkLocalMoodle -Config $Config

        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'Démarrer Moodle local' `
                -Status $(if ($startResult.success) { 'Réussi' } else { 'Échoué' }) `
                -Summary $startResult.summary `
                -Detail $startResult.nextStep `
                -Data $startResult
        )

        if (-not $startResult.success) {
            $result = Add-UckkLocalError `
                -Result $result `
                -ErrorMessage 'Moodle local ne répond pas et n a pas pu être démarré.'

            $result.data = [pscustomobject]@{
                baseUrl     = $baseUrl
                url         = $url
                baseCheck   = $baseCheck
                startResult = $startResult
            }

            return Complete-UckkLocalResult `
                -Result $result `
                -Summary 'Échoué — Moodle local ne répond pas.' `
                -NextStep 'Corriger PHP, le port local ou paths.localMoodleRuntime, puis relancer.'
        }

        $baseCheck = Wait-UckkLocalUrlResponding `
            -Url $baseUrl `
            -TimeoutSeconds 30 `
            -DelayMilliseconds 1000 `
            -RequestTimeoutSeconds 5
    }
    else {
        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'Vérifier Moodle local' `
                -Status 'Réussi' `
                -Summary 'Moodle local répond déjà.' `
                -Detail $baseUrl `
                -Data $baseCheck
        )
    }

    if (-not $baseCheck.success) {
        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'Attendre Moodle local' `
                -Status 'Réussi avec avertissements' `
                -Summary 'Moodle local peut encore terminer son démarrage.' `
                -Detail $baseCheck.detail `
                -Data $baseCheck
        )

        $result = Add-UckkLocalWarning `
            -Result $result `
            -Warning "Moodle local ne répondait pas encore au moment de l ouverture : $baseUrl"

        try {
            Start-Process $url

            $result = Add-UckkLocalStep -Result $result -Step (
                New-UckkLocalStep `
                    -Name 'Ouvrir navigateur' `
                    -Status 'Réussi avec avertissements' `
                    -Summary 'Navigateur ouvert pendant que Moodle local termine son démarrage.' `
                    -Detail $url
            )
        }
        catch {
            $result = Add-UckkLocalWarning `
                -Result $result `
                -Warning "Le navigateur n a pas pu être ouvert automatiquement : $($_.Exception.Message)"
        }

        $result.data = [pscustomobject]@{
            baseUrl   = $baseUrl
            url       = $url
            baseCheck = $baseCheck
        }

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Réussi avec avertissements — Moodle local a été lancé, mais pouvait encore terminer son démarrage au moment de l ouverture.' `
            -NextStep 'Attendre quelques secondes, puis vérifier ou actualiser la page dans le navigateur.'
    }

    try {
        Start-Process $url

        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'Ouvrir navigateur' `
                -Status 'Réussi' `
                -Summary 'Navigateur ouvert.' `
                -Detail $url
        )

        $result.data = [pscustomobject]@{
            baseUrl   = $baseUrl
            url       = $url
            baseCheck = $baseCheck
        }

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary "Réussi — Moodle local répond et a été ouvert : $url" `
            -NextStep 'Vérifier la page dans le navigateur.'
    }
    catch {
        $result = Add-UckkLocalError -Result $result -ErrorMessage $_.Exception.Message

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Échoué — le navigateur n a pas pu être ouvert.' `
            -NextStep 'Copier l URL locale et l ouvrir manuellement.'
    }
}

function Open-UckkLocalFacade {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config,

        [Parameter(Mandatory)]
        [string] $FacadeId
    )

    try {
        $facade = Get-UckkLocalPublicFacade -Config $Config -Id $FacadeId
        $label = [string](Get-UckkLocalObjectPropertyValue -Object $facade -Name 'label' -Default $FacadeId)
        $theme = [string](Get-UckkLocalObjectPropertyValue -Object $facade -Name 'theme' -Default '')

        if ([string]::IsNullOrWhiteSpace($theme)) {
            throw "Thème Moodle absent pour la façade $FacadeId."
        }
    }
    catch {
        return New-UckkLocalRefusedResult `
            -Action "Ouvrir façade locale : $FacadeId" `
            -Target 'Moodle local' `
            -DangerLevel 0 `
            -Mode 'navigation' `
            -Cause $_.Exception.Message `
            -NextStep 'Corriger publicFacades.sites dans la configuration.'
    }

    $openResult = Open-UckkLocalMoodle -Config $Config -Path "/?theme=$theme"

    if ($null -ne $openResult) {
        $openResult.action = "Ouvrir $label"
        $openResult.target = "façade locale $FacadeId"
        $openResult.nextStep = "Vérifier la façade $label dans le navigateur."
    }

    return $openResult
}

