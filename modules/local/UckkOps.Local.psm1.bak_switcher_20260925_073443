function Test-UckkLocalPublicFacades {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config,

        [Parameter()]
        [int] $TimeoutSeconds = 15
    )

    $action = 'Tester switcher UCKK / UCC / Math'

    try {
        $baseUrl = [string](Get-UckkLocalConfigValue -Config $Config -Path 'urls.localBase' -Required)
        $facades = @(Get-UckkLocalPublicFacades -Config $Config)
        $testPaths = @(Get-UckkLocalConfigValue -Config $Config -Path 'publicFacades.testPaths' -Default @('/', '/local/uckk/about.php', '/local/uckk/programs.php', '/local/uckk/courses.php', '/local/uckk/mediatheque.php'))
    }
    catch {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'façades publiques locales' `
            -DangerLevel 1 `
            -Mode 'test' `
            -Cause $_.Exception.Message `
            -NextStep 'Corriger urls.localBase et publicFacades dans la configuration.'
    }

    $result = New-UckkLocalResult `
        -Action $action `
        -Target 'façades publiques locales' `
        -DangerLevel 1 `
        -Mode 'test' `
        -Status 'En cours' `
        -Summary 'Test des trois façades publiques et du switcher Moodle.'

    $checks = [System.Collections.Generic.List[object]]::new()

    foreach ($facade in $facades) {
        $id = [string](Get-UckkLocalObjectPropertyValue -Object $facade -Name 'id' -Default '')
        $label = [string](Get-UckkLocalObjectPropertyValue -Object $facade -Name 'label' -Default $id)
        $theme = [string](Get-UckkLocalObjectPropertyValue -Object $facade -Name 'theme' -Default '')
        $marker = [string](Get-UckkLocalObjectPropertyValue -Object $facade -Name 'expectedMarker' -Default '')

        if ([string]::IsNullOrWhiteSpace($id) -or [string]::IsNullOrWhiteSpace($theme)) {
            $result = Add-UckkLocalError -Result $result -ErrorMessage 'Une façade publique n a pas id/theme.'
            continue
        }

        foreach ($path in $testPaths) {
            $pathText = [string]$path
            $separator = if ($pathText.Contains('?')) { '&' } else { '?' }
            $themedPath = "$pathText$separator" + "theme=$theme"
            $url = Join-UckkLocalUrl -BaseUrl $baseUrl -Path $themedPath

            try {
                $response = Invoke-WebRequest -Uri $url -UseBasicParsing -TimeoutSec $TimeoutSeconds -ErrorAction Stop
                $httpOk = ($response.StatusCode -ge 200 -and $response.StatusCode -lt 400)
                $markerChecked = ($pathText -eq '/' -and -not [string]::IsNullOrWhiteSpace($marker))
                $markerOk = $true

                if ($markerChecked) {
                    $markerOk = ([string]$response.Content).Contains($marker)
                }

                $ok = ($httpOk -and $markerOk)
                $detail = if (-not $httpOk) {
                    "HTTP $($response.StatusCode)"
                }
                elseif ($markerChecked -and -not $markerOk) {
                    "Marqueur attendu absent : $marker"
                }
                else {
                    "HTTP $($response.StatusCode)"
                }

                $check = [pscustomobject]@{
                    facade       = $id
                    label        = $label
                    theme        = $theme
                    path         = $pathText
                    url          = $url
                    statusCode   = $response.StatusCode
                    marker       = $marker
                    markerChecked = $markerChecked
                    markerOk     = $markerOk
                    success      = $ok
                    detail       = $detail
                }
                $checks.Add($check)

                $result = Add-UckkLocalStep -Result $result -Step (
                    New-UckkLocalStep `
                        -Name "Tester $label — $pathText" `
                        -Status $(if ($ok) { 'Réussi' } else { 'Échoué' }) `
                        -Summary $detail `
                        -Detail $url `
                        -Data $check
                )

                if (-not $ok) {
                    $result = Add-UckkLocalError -Result $result -ErrorMessage "La façade $label ne correspond pas au thème attendu : $url"
                }
            }
            catch {
                $check = [pscustomobject]@{
                    facade       = $id
                    label        = $label
                    theme        = $theme
                    path         = $pathText
                    url          = $url
                    statusCode   = $null
                    marker       = $marker
                    markerChecked = $false
                    markerOk     = $false
                    success      = $false
                    detail       = $_.Exception.Message
                }
                $checks.Add($check)

                $result = Add-UckkLocalStep -Result $result -Step (
                    New-UckkLocalStep `
                        -Name "Tester $label — $pathText" `
                        -Status 'Échoué' `
                        -Summary 'La page ne répond pas correctement.' `
                        -Detail "$url — $($_.Exception.Message)" `
                        -Data $check
                )

                $result = Add-UckkLocalError -Result $result -ErrorMessage "La façade $label ne répond pas : $url"
            }
        }
    }

    $result.data = [pscustomobject]@{
        baseUrl = $baseUrl
        facades = $facades
        checks = $checks
    }

    if ((Get-UckkLocalResultListCount -Result $result -PropertyName 'errors') -gt 0) {
        $result = Add-UckkLocalWarning `
            -Result $result `
            -Warning 'Si UCC et Math retournent le contenu UCKK, vérifier Administration du site > Apparence > Thèmes > Autoriser le changement de thème dans l URL.'

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Échoué — une ou plusieurs façades ne répondent pas avec le thème/contenu attendu.' `
            -NextStep 'Vérifier les thèmes installés, activer le changement de thème par URL, purger les caches puis relancer le test.'
    }

    $result = Add-UckkLocalWarning `
        -Result $result `
        -Warning 'Le test confirme HTTP et l identité textuelle de la façade. Il ne remplace pas une inspection visuelle du navigateur ni les tests AJAX.'

    return Complete-UckkLocalResult `
        -Result $result `
        -Summary 'Réussi avec avertissements — UCKK, UCC et Math répondent avec leur identité attendue.' `
        -NextStep 'Ouvrir chaque façade dans le navigateur et vérifier Cours/Médiathèque visuellement.'
}

function Test-UckkLocalPages {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config,

        [Parameter()]
        [string[]] $Paths = @(
            '/',
            '/local/uckk/index.php',
            '/local/uckk/courses.php',
            '/local/uckk/mediatheque.php',
            '/local/uckk/faculty.php?slug=economie',
            '/local/uckk/faculty.php?slug=ecosysteme-digital-koa'
        ),

        [Parameter()]
        [int] $TimeoutSeconds = 15
    )

    $action = 'Tester les pages locales'

    try {
        $baseUrl = [string] (Get-UckkLocalConfigValue -Config $Config -Path 'urls.localBase' -Required)
    }
    catch {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'Moodle local' `
            -DangerLevel 1 `
            -Mode 'test' `
            -Cause $_.Exception.Message `
            -NextStep 'Corriger urls.localBase dans la configuration.'
    }

    $result = New-UckkLocalResult `
        -Action $action `
        -Target 'Moodle local' `
        -DangerLevel 1 `
        -Mode 'test' `
        -Status 'En cours' `
        -Summary 'Test des pages locales en cours.'

    $pageResults = [System.Collections.Generic.List[object]]::new()

    foreach ($path in $Paths) {
        $url = Join-UckkLocalUrl -BaseUrl $baseUrl -Path $path

        try {
            $response = Invoke-WebRequest `
                -Uri $url `
                -UseBasicParsing `
                -TimeoutSec $TimeoutSeconds `
                -ErrorAction Stop

            $ok = ($response.StatusCode -ge 200 -and $response.StatusCode -lt 400)

            $pageData = [pscustomobject]@{
                path       = $path
                url        = $url
                statusCode = $response.StatusCode
                success    = $ok
                detail     = $response.StatusDescription
            }

            $pageResults.Add($pageData)

            $result = Add-UckkLocalStep -Result $result -Step (
                New-UckkLocalStep `
                    -Name "Tester $path" `
                    -Status $(if ($ok) { 'Réussi' } else { 'Échoué' }) `
                    -Summary "HTTP $($response.StatusCode)" `
                    -Detail $url `
                    -Data $pageData
            )

            if (-not $ok) {
                $result = Add-UckkLocalError -Result $result -ErrorMessage "La page locale ne répond pas correctement : $url"
            }
        }
        catch {
            $pageData = [pscustomobject]@{
                path       = $path
                url        = $url
                statusCode = $null
                success    = $false
                detail     = $_.Exception.Message
            }

            $pageResults.Add($pageData)

            $result = Add-UckkLocalStep -Result $result -Step (
                New-UckkLocalStep `
                    -Name "Tester $path" `
                    -Status 'Échoué' `
                    -Summary 'La page locale ne répond pas correctement.' `
                    -Detail "$url — $($_.Exception.Message)" `
                    -Data $pageData
            )

            $result = Add-UckkLocalError -Result $result -ErrorMessage "La page locale ne répond pas : $url"
        }
    }

    $result.data = [pscustomobject]@{
        baseUrl = $baseUrl
        pages   = $pageResults
    }

    if ((Get-UckkLocalResultListCount -Result $result -PropertyName 'errors') -gt 0) {
        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Échoué — une ou plusieurs pages locales ne répondent pas correctement.' `
            -NextStep 'Démarrer Moodle local, purger les caches locaux, puis relancer le test.'
    }

    $result = Add-UckkLocalWarning `
        -Result $result `
        -Warning 'HTTP 200 confirme que la page répond, mais ne confirme pas toujours l affichage complet ou les données chargées par AJAX.'

    return Complete-UckkLocalResult `
        -Result $result `
        -Summary 'Réussi avec avertissements — les pages locales testées répondent.' `
        -NextStep 'Vérifier dans le navigateur les pages qui dépendent de JavaScript ou AJAX.'
}

function Get-UckkLocalStatus {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config
    )

    $action = 'Vérifier l état local'

    $result = New-UckkLocalResult `
        -Action $action `
        -Target 'local' `
        -DangerLevel 1 `
        -Mode 'vérification' `
        -Status 'En cours' `
        -Summary 'Vérification rapide de l état local.'

    $pathResult = Test-UckkLocalPaths -Config $Config

    $result.data = [pscustomobject]@{
        paths = $pathResult.data
    }

    if ((Get-UckkLocalResultListCount -Result $pathResult -PropertyName 'errors') -gt 0) {
        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'Vérifier chemins locaux' `
                -Status 'Échoué' `
                -Summary 'Les chemins locaux ne sont pas tous valides.' `
                -Data $pathResult
        )

        $result = Add-UckkLocalError -Result $result -ErrorMessage 'Les chemins locaux obligatoires ne sont pas tous valides.'

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Échoué — l état local n est pas prêt.' `
            -NextStep 'Corriger les chemins locaux avant de continuer.'
    }

    $result = Add-UckkLocalStep -Result $result -Step (
        New-UckkLocalStep `
            -Name 'Vérifier chemins locaux' `
            -Status 'Réussi' `
            -Summary 'Les chemins locaux obligatoires sont valides.' `
            -Data $pathResult
    )

    return Complete-UckkLocalResult `
        -Result $result `
        -Summary 'Réussi — l état local de base est prêt.' `
        -NextStep 'Synchroniser source vers Moodle local ou tester les pages locales.'
}

