function Invoke-UckkLocalProcess {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $FilePath,

        [Parameter()]
        [string[]] $ArgumentList = @(),

        [Parameter()]
        [string] $WorkingDirectory = '',

        [Parameter()]
        [int] $TimeoutSeconds = 120
    )

    $startedAt = Get-Date
    $commandParts = [System.Collections.Generic.List[string]]::new()
    $commandParts.Add($FilePath)

    foreach ($arg in $ArgumentList) {
        $argText = [string] $arg
        if ($argText -match '\s|"') {
            $escaped = $argText.Replace('"', '\"')
            $commandParts.Add('"' + $escaped + '"')
        }
        else {
            $commandParts.Add($argText)
        }
    }

    $commandLine = ($commandParts -join ' ')

    try {
        $process = [System.Diagnostics.Process]::new()
        $process.StartInfo.FileName = $FilePath

        foreach ($arg in $ArgumentList) {
            [void] $process.StartInfo.ArgumentList.Add([string] $arg)
        }

        if (-not [string]::IsNullOrWhiteSpace($WorkingDirectory)) {
            $process.StartInfo.WorkingDirectory = $WorkingDirectory
        }

        $process.StartInfo.RedirectStandardOutput = $true
        $process.StartInfo.RedirectStandardError = $true
        $process.StartInfo.UseShellExecute = $false
        $process.StartInfo.CreateNoWindow = $true

        [void] $process.Start()

        $stdoutTask = $process.StandardOutput.ReadToEndAsync()
        $stderrTask = $process.StandardError.ReadToEndAsync()

        $completed = $process.WaitForExit($TimeoutSeconds * 1000)

        if (-not $completed) {
            try {
                $process.Kill($true)
            }
            catch {
                # Ignore secondary kill failure.
            }

            $finishedAt = Get-Date
            return [pscustomobject]@{
                success         = $false
                timedOut        = $true
                exitCode        = $null
                stdout          = ''
                stderr          = "Timeout après $TimeoutSeconds secondes."
                filePath        = $FilePath
                arguments       = @($ArgumentList)
                workingDir      = $WorkingDirectory
                timeoutSeconds  = $TimeoutSeconds
                commandLine     = $commandLine
                startedAt       = $startedAt.ToString('yyyy-MM-dd HH:mm:ss.fff')
                finishedAt      = $finishedAt.ToString('yyyy-MM-dd HH:mm:ss.fff')
                durationSeconds = [math]::Round(($finishedAt - $startedAt).TotalSeconds, 3)
            }
        }

        $finishedAt = Get-Date
        return [pscustomobject]@{
            success         = ($process.ExitCode -eq 0)
            timedOut        = $false
            exitCode        = $process.ExitCode
            stdout          = $stdoutTask.Result
            stderr          = $stderrTask.Result
            filePath        = $FilePath
            arguments       = @($ArgumentList)
            workingDir      = $WorkingDirectory
            timeoutSeconds  = $TimeoutSeconds
            commandLine     = $commandLine
            startedAt       = $startedAt.ToString('yyyy-MM-dd HH:mm:ss.fff')
            finishedAt      = $finishedAt.ToString('yyyy-MM-dd HH:mm:ss.fff')
            durationSeconds = [math]::Round(($finishedAt - $startedAt).TotalSeconds, 3)
        }
    }
    catch {
        $finishedAt = Get-Date
        return [pscustomobject]@{
            success         = $false
            timedOut        = $false
            exitCode        = $null
            stdout          = ''
            stderr          = $_.Exception.Message
            filePath        = $FilePath
            arguments       = @($ArgumentList)
            workingDir      = $WorkingDirectory
            timeoutSeconds  = $TimeoutSeconds
            commandLine     = $commandLine
            startedAt       = $startedAt.ToString('yyyy-MM-dd HH:mm:ss.fff')
            finishedAt      = $finishedAt.ToString('yyyy-MM-dd HH:mm:ss.fff')
            durationSeconds = [math]::Round(($finishedAt - $startedAt).TotalSeconds, 3)
            exceptionType   = $_.Exception.GetType().FullName
        }
    }
}

function ConvertTo-UckkLocalProcessDetail {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $ProcessResult
    )

    $lines = [System.Collections.Generic.List[string]]::new()
    $lines.Add("Commande : $([string](Get-UckkLocalObjectPropertyValue -Object $ProcessResult -Name 'commandLine' -Default ''))")
    $lines.Add("Dossier courant : $([string](Get-UckkLocalObjectPropertyValue -Object $ProcessResult -Name 'workingDir' -Default ''))")
    $lines.Add("Code de sortie : $([string](Get-UckkLocalObjectPropertyValue -Object $ProcessResult -Name 'exitCode' -Default 'non disponible'))")
    $lines.Add("Timeout : $([string](Get-UckkLocalObjectPropertyValue -Object $ProcessResult -Name 'timedOut' -Default $false))")
    $lines.Add("Durée : $([string](Get-UckkLocalObjectPropertyValue -Object $ProcessResult -Name 'durationSeconds' -Default '')) s")
    $lines.Add('')
    $lines.Add('STDOUT :')
    $stdout = [string](Get-UckkLocalObjectPropertyValue -Object $ProcessResult -Name 'stdout' -Default '')
    $lines.Add($(if ([string]::IsNullOrWhiteSpace($stdout)) { '(vide)' } else { $stdout.TrimEnd() }))
    $lines.Add('')
    $lines.Add('STDERR :')
    $stderr = [string](Get-UckkLocalObjectPropertyValue -Object $ProcessResult -Name 'stderr' -Default '')
    $lines.Add($(if ([string]::IsNullOrWhiteSpace($stderr)) { '(vide)' } else { $stderr.TrimEnd() }))

    return ($lines -join [Environment]::NewLine)
}

function Resolve-UckkLocalMoodleCliContext {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config,

        [Parameter(Mandatory)]
        [string] $ScriptRelativePath
    )

    $localMoodleRoot = ConvertTo-UckkLocalFullPath -Path (
        Get-UckkLocalConfigValue -Config $Config -Path 'paths.localMoodleRoot' -Required
    )

    $localMoodleRuntime = ConvertTo-UckkLocalFullPath -Path (
        Get-UckkLocalConfigValue -Config $Config -Path 'paths.localMoodleRuntime' -Required
    )

    # localMoodleRoot is the CLI/code root. localMoodleRuntime is the web document root.
    # Keep fallback candidates for older layouts, but prefer the configured code root.
    $candidateRoots = [System.Collections.Generic.List[string]]::new()
    foreach ($candidate in @(
        $localMoodleRoot,
        $localMoodleRuntime,
        (Join-Path $localMoodleRoot 'public')
    )) {
        if ([string]::IsNullOrWhiteSpace([string] $candidate)) {
            continue
        }

        $candidateFull = ConvertTo-UckkLocalFullPath -Path ([string] $candidate)
        if (-not $candidateRoots.Contains($candidateFull)) {
            $candidateRoots.Add($candidateFull)
        }
    }

    $probes = [System.Collections.Generic.List[object]]::new()
    $resolvedRoot = ''
    $resolvedScript = ''

    foreach ($candidateRoot in $candidateRoots) {
        $candidateScript = Join-Path $candidateRoot $ScriptRelativePath
        $exists = Test-Path -LiteralPath $candidateScript -PathType Leaf

        $probes.Add([pscustomobject]@{
            root       = $candidateRoot
            script     = $candidateScript
            scriptExists = $exists
            rootExists = (Test-Path -LiteralPath $candidateRoot -PathType Container)
        })

        if ([string]::IsNullOrWhiteSpace($resolvedScript) -and $exists) {
            $resolvedRoot = $candidateRoot
            $resolvedScript = $candidateScript
        }
    }

    $configCandidates = @(
        (Join-Path $localMoodleRoot 'config.php'),
        (Join-Path $localMoodleRuntime 'config.php'),
        (Join-Path (Join-Path $localMoodleRoot 'public') 'config.php')
    ) | Select-Object -Unique

    $configProbes = foreach ($configCandidate in $configCandidates) {
        [pscustomobject]@{
            path   = $configCandidate
            exists = (Test-Path -LiteralPath $configCandidate -PathType Leaf)
        }
    }

    return [pscustomobject]@{
        success            = (-not [string]::IsNullOrWhiteSpace($resolvedScript))
        scriptRelativePath = $ScriptRelativePath
        cliRoot            = $resolvedRoot
        scriptPath         = $resolvedScript
        localMoodleRoot    = $localMoodleRoot
        localMoodleRuntime = $localMoodleRuntime
        candidateRoots     = @($candidateRoots)
        probes             = @($probes)
        configProbes       = @($configProbes)
    }
}

function Get-UckkLocalPhpBinary {
