        [Parameter()]
        [ValidateSet(
            'Prêt',
            'En cours',
            'Réussi',
            'Réussi avec avertissements',
            'Échoué',
            'Annulé',
            'À vérifier dans le navigateur'
        )]
        [string] $Status = 'Prêt',

        [Parameter()]
        [bool] $Success = $false,

        [Parameter()]
        [string] $Summary = '',

        [Parameter()]
        [string] $NextStep = '',

        [Parameter()]
        [AllowNull()]
        [object] $Data = $null
    )

    if (Get-Command -Name New-UckkActionResult -ErrorAction SilentlyContinue) {
