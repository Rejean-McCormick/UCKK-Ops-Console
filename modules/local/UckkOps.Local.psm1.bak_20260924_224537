function Add-UckkLocalWarning {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [psobject] $Result,

        [Parameter(Mandatory)]
        [string] $Warning
    )

    if (Get-Command -Name Add-UckkActionWarning -ErrorAction SilentlyContinue) {
