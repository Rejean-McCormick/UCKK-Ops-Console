function Get-UckkLocalConfigValue {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config,

        [Parameter(Mandatory)]
        [string] $Path,

        [Parameter()]
        [switch] $Required,

        [Parameter()]
        [AllowNull()]
        [object] $Default = $null
    )

    $current = $Config

    foreach ($part in ($Path -split '\.')) {
        if ($null -eq $current) {
            if ($Required) {
                throw "Configuration manquante : $Path"
            }

            return $Default
        }

        if ($current -is [hashtable]) {
            if (-not $current.ContainsKey($part)) {
                if ($Required) {
                    throw "Configuration manquante : $Path"
                }

                return $Default
            }

            $current = $current[$part]
            continue
        }

        $property = $current.PSObject.Properties[$part]

        if ($null -eq $property) {
            if ($Required) {
                throw "Configuration manquante : $Path"
            }

            return $Default
        }

        $current = $property.Value
    }

    if ($Required -and ($null -eq $current -or [string]::IsNullOrWhiteSpace([string] $current))) {
        throw "Configuration vide : $Path"
    }

    if ($null -eq $current) {
        return $Default
    }

    return $current
}

function ConvertTo-UckkLocalFullPath {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $Path
    )

    return [System.IO.Path]::GetFullPath(
        [Environment]::ExpandEnvironmentVariables($Path)
    )
}

function Test-UckkLocalPathInside {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $ChildPath,

        [Parameter(Mandatory)]
        [string] $ParentPath
    )

    $child = ConvertTo-UckkLocalFullPath -Path $ChildPath
    $parent = ConvertTo-UckkLocalFullPath -Path $ParentPath

    if (-not $parent.EndsWith([System.IO.Path]::DirectorySeparatorChar)) {
        $parent += [System.IO.Path]::DirectorySeparatorChar
    }

    return $child.StartsWith($parent, [System.StringComparison]::OrdinalIgnoreCase)
}

function Join-UckkLocalUrl {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $BaseUrl,

        [Parameter()]
        [string] $Path = '/'
    )

    $base = $BaseUrl.TrimEnd('/')

    if ([string]::IsNullOrWhiteSpace($Path)) {
        return $base
    }

    if ($Path.StartsWith('/')) {
        return "$base$Path"
    }

    return "$base/$Path"
}

function Get-UckkLocalPublicFacades {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config
    )

    $configured = @(Get-UckkLocalConfigValue -Config $Config -Path 'publicFacades.sites' -Default @())

    if ($configured.Count -gt 0) {
        return $configured
    }

    # Backward-compatible fallback. Updated configurations should declare these explicitly.
    return @(
        [pscustomobject]@{ id = 'uckk'; label = 'UCKK'; theme = 'uckk'; expectedMarker = 'Univers-Cité King Klown' },
        [pscustomobject]@{ id = 'ucc'; label = 'UCC — Univers-Cité Catho'; theme = 'ucc'; expectedMarker = 'Univers-Cité Catho' },
        [pscustomobject]@{ id = 'math'; label = 'Math — Univers-Cité des mathématiques'; theme = 'ucmath'; expectedMarker = 'Univers-Cité des mathématiques' }
    )
}

function Get-UckkLocalPublicFacade {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config,

        [Parameter(Mandatory)]
        [string] $Id
    )

    foreach ($facade in @(Get-UckkLocalPublicFacades -Config $Config)) {
        $facadeId = [string](Get-UckkLocalObjectPropertyValue -Object $facade -Name 'id' -Default '')

        if ($facadeId -eq $Id) {
            return $facade
        }
    }

    throw "Façade publique inconnue : $Id"
}

