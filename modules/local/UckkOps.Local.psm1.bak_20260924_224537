function New-UckkLocalStep {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $Name,

        [Parameter()]
        [ValidateSet(
            'Non lancée',
            'En cours',
            'Réussi',
            'Réussi avec avertissements',
            'Échoué',
            'Ignoré',
            'Annulé'
        )]
        [string] $Status = 'Non lancée',

        [Parameter()]
        [string] $Summary = '',

        [Parameter()]
        [string] $Detail = '',

        [Parameter()]
        [AllowNull()]
        [object] $Data = $null
    )

    if (Get-Command -Name New-UckkActionStep -ErrorAction SilentlyContinue) {
        return New-UckkActionStep `
            -Name $Name `
            -Status $Status `
            -Summary $Summary `
            -Detail $Detail `
            -Data $Data
    }

    return [pscustomobject]@{
        name      = $Name
        status    = $Status
        summary   = $Summary
        detail    = $Detail
        data      = $Data
        timestamp = (Get-Date).ToString('yyyy-MM-dd HH:mm:ss')
    }
}

