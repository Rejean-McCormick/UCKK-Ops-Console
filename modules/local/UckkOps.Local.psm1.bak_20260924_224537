function Test-UckkLocalPaths {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config
    )

    $action = 'Vérifier les chemins locaux'

    $result = New-UckkLocalResult `
        -Action $action `
        -Target 'local' `
        -DangerLevel 1 `
        -Mode 'vérification' `
        -Status 'En cours' `
        -Summary 'Vérification des chemins locaux en cours.'

    $checks = [System.Collections.Generic.List[object]]::new()

    $items = @(
        @{ label = 'Racine de l application'; path = 'app.root'; required = $false; type = 'directory' },
        @{ label = 'Source Git locale'; path = 'paths.uckkMoodleSource'; required = $true; type = 'directory' },
        @{ label = 'Moodle local'; path = 'paths.localMoodleRoot'; required = $true; type = 'directory' },
        @{ label = 'Dossier exécuté par Moodle local'; path = 'paths.localMoodleRuntime'; required = $true; type = 'directory' },
        @{ label = 'Dossier des rapports'; path = 'reports.dir'; required = $false; type = 'directory' },
        @{ label = 'Dossier des logs'; path = 'logs.dir'; required = $false; type = 'directory' }
    )

    foreach ($item in $items) {
        try {
            $value = Get-UckkLocalConfigValue `
                -Config $Config `
                -Path $item.path `
                -Required:([bool] $item.required)

            if ($null -eq $value -or [string]::IsNullOrWhiteSpace([string] $value)) {
                $checks.Add([pscustomobject]@{
                    label  = $item.label
                    key    = $item.path
                    path   = ''
                    exists = $false
                    status = 'Ignoré'
                    detail = 'Non configuré.'
                })

                continue
            }

            $fullPath = ConvertTo-UckkLocalFullPath -Path ([string] $value)
            $exists = Test-Path -LiteralPath $fullPath

            $checks.Add([pscustomobject]@{
                label  = $item.label
                key    = $item.path
                path   = $fullPath
                exists = $exists
                status = $(if ($exists) { 'Réussi' } else { 'Échoué' })
                detail = $(if ($exists) { 'Chemin trouvé.' } else { 'Chemin introuvable.' })
            })

            if ($exists) {
                $result = Add-UckkLocalStep -Result $result -Step (
                    New-UckkLocalStep `
                        -Name $item.label `
                        -Status 'Réussi' `
                        -Summary 'Chemin trouvé.' `
                        -Detail $fullPath
                )
            }

            else {
                $result = Add-UckkLocalStep -Result $result -Step (
                    New-UckkLocalStep `
                        -Name $item.label `
                        -Status 'Échoué' `
                        -Summary 'Chemin introuvable.' `
                        -Detail $fullPath
                )

                if ($item.required) {
                    $result = Add-UckkLocalError -Result $result -ErrorMessage "$($item.label) introuvable : $fullPath"
                }
                else {
                    $result = Add-UckkLocalWarning -Result $result -Warning "$($item.label) introuvable : $fullPath"
                }
            }
        }
        catch {
            $message = $_.Exception.Message

            $checks.Add([pscustomobject]@{
                label  = $item.label
                key    = $item.path
                path   = ''
                exists = $false
                status = 'Échoué'
                detail = $message
            })

            $result = Add-UckkLocalError -Result $result -ErrorMessage $message
            $result = Add-UckkLocalStep -Result $result -Step (
                New-UckkLocalStep `
                    -Name $item.label `
                    -Status 'Échoué' `
                    -Summary $message
            )
        }
    }

    try {
        $localUrl = Get-UckkLocalConfigValue -Config $Config -Path 'urls.localBase' -Required

        $checks.Add([pscustomobject]@{
            label  = 'URL locale'
            key    = 'urls.localBase'
            path   = [string] $localUrl
            exists = $true
            status = 'Réussi'
            detail = 'URL configurée.'
        })

        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'URL locale' `
                -Status 'Réussi' `
                -Summary 'URL configurée.' `
                -Detail ([string] $localUrl)
        )
    }
    catch {
        $result = Add-UckkLocalError -Result $result -ErrorMessage $_.Exception.Message
    }

    $result.data = [pscustomobject]@{
        checks = $checks
    }

    if ((Get-UckkLocalResultListCount -Result $result -PropertyName 'errors') -gt 0) {
        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Échoué — un ou plusieurs chemins locaux obligatoires sont absents.' `
            -NextStep 'Corriger la configuration ou créer les dossiers nécessaires.'
    }

    if ((Get-UckkLocalResultListCount -Result $result -PropertyName 'warnings') -gt 0) {
        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Réussi avec avertissements — les chemins locaux obligatoires sont présents.' `
            -NextStep 'Lire les avertissements avant de continuer.'
    }

    return Complete-UckkLocalResult `
        -Result $result `
        -Summary 'Réussi — les chemins locaux obligatoires sont présents.' `
        -NextStep 'Synchroniser source vers Moodle local si nécessaire.'
}

function Sync-UckkSourceToLocalMoodle {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config,

        [Parameter()]
        [switch] $Simulation
    )

    $action = $(if ($Simulation) { 'Simulation synchronisation source vers Moodle local' } else { 'Synchroniser source vers Moodle local' })

    $result = New-UckkLocalResult `
        -Action $action `
        -Target 'dossier exécuté par Moodle local' `
        -DangerLevel 2 `
        -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
        -Status 'En cours' `
        -Summary 'Synchronisation locale en cours.'

    try {
        $source = ConvertTo-UckkLocalFullPath -Path (
            Get-UckkLocalConfigValue -Config $Config -Path 'paths.uckkMoodleSource' -Required
        )

        $localMoodleRoot = ConvertTo-UckkLocalFullPath -Path (
            Get-UckkLocalConfigValue -Config $Config -Path 'paths.localMoodleRoot' -Required
        )

        $target = ConvertTo-UckkLocalFullPath -Path (
            Get-UckkLocalConfigValue -Config $Config -Path 'paths.localMoodleRuntime' -Required
        )
    }
    catch {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'dossier exécuté par Moodle local' `
            -DangerLevel 2 `
            -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
            -Cause $_.Exception.Message `
            -NextStep 'Corriger la configuration des chemins locaux.'
    }

    if (-not (Test-Path -LiteralPath $source -PathType Container)) {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'dossier exécuté par Moodle local' `
            -DangerLevel 2 `
            -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
            -Cause "Source locale introuvable : $source" `
            -NextStep 'Vérifier paths.uckkMoodleSource.'
    }

    if (-not (Test-Path -LiteralPath $target -PathType Container)) {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'dossier exécuté par Moodle local' `
            -DangerLevel 2 `
            -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
            -Cause "Dossier exécuté par Moodle local introuvable : $target" `
            -NextStep 'Vérifier paths.localMoodleRuntime.'
    }

    if (-not (Test-UckkLocalPathInside -ChildPath $target -ParentPath $localMoodleRoot)) {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'dossier exécuté par Moodle local' `
            -DangerLevel 2 `
            -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
            -Cause "La cible locale n est pas située dans le Moodle local configuré : $target" `
            -NextStep 'Vérifier paths.localMoodleRoot et paths.localMoodleRuntime.'
    }

    if ($source -eq $target) {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'dossier exécuté par Moodle local' `
            -DangerLevel 2 `
            -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
            -Cause 'La source et la cible sont identiques.' `
            -NextStep 'Corriger la configuration avant de synchroniser.'
    }

    $result = Add-UckkLocalStep -Result $result -Step (
        New-UckkLocalStep `
            -Name 'Vérifier source locale' `
            -Status 'Réussi' `
            -Summary 'Source locale trouvée.' `
            -Detail $source
    )

    $result = Add-UckkLocalStep -Result $result -Step (
        New-UckkLocalStep `
            -Name 'Vérifier cible Moodle locale' `
            -Status 'Réussi' `
-Summary 'Cible locale trouvée.' `
            -Detail $target
    )

    try {
        $copyResult = Copy-UckkLocalTree `
            -SourceDir $source `
            -TargetDir $target `
            -Simulation:$Simulation

        $result.data = $copyResult

        if ($copyResult.failed -gt 0) {
            foreach ($failure in $copyResult.failureItems) {
                $result = Add-UckkLocalError -Result $result -ErrorMessage $failure
            }

            $result = Add-UckkLocalStep -Result $result -Step (
                New-UckkLocalStep `
                    -Name 'Copier fichiers' `
                    -Status 'Échoué' `
                    -Summary "$($copyResult.failed) fichier(s) en échec." `
                    -Data $copyResult
            )

            return Complete-UckkLocalResult `
                -Result $result `
                -Summary 'Échoué — la synchronisation locale n est pas complète.' `
                -NextStep 'Lire les erreurs, corriger les fichiers concernés, puis relancer.'
        }

        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name $(if ($Simulation) { 'Simuler copie fichiers' } else { 'Copier fichiers' }) `
                -Status 'Réussi' `
                -Summary "$($copyResult.copied) fichier(s) traité(s), $($copyResult.skipped) ignoré(s)." `
                -Data $copyResult
        )

        if ($Simulation) {
            return Complete-UckkLocalResult `
                -Result $result `
                -Summary "Réussi — simulation terminée. Aucune donnée locale n a été modifiée. $($copyResult.copied) fichier(s) seraient copiés, $($copyResult.skipped) ignoré(s)." `
                -NextStep 'Lancer "Synchroniser source vers Moodle local" si tout est correct.'
        }

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary "Réussi — la source a été copiée vers Moodle local. $($copyResult.copied) fichier(s) copiés, $($copyResult.skipped) ignoré(s)." `
            -NextStep 'Purger les caches locaux, puis ouvrir Moodle local.'
    }
    catch {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'dossier exécuté par Moodle local' `
            -DangerLevel 2 `
            -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
            -Cause $_.Exception.Message `
            -NextStep 'Lire le détail technique et corriger la cause.'
    }
}

function Invoke-UckkLocalMoodleUpgrade {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config,

        [Parameter()]
        [switch] $Confirmed
    )

    $action = 'Mettre à jour Moodle local'

    if (-not $Confirmed) {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'base Moodle locale' `
            -DangerLevel 3 `
            -Mode 'application' `
            -Cause 'Confirmation requise avant un upgrade Moodle local.' `
            -NextStep 'Relancer l action et confirmer la modification potentielle de la base Moodle locale.'
    }

    $result = New-UckkLocalResult `
        -Action $action `
        -Target 'base Moodle locale' `
        -DangerLevel 3 `
        -Mode 'application' `
        -Status 'En cours' `
        -Summary 'Recherche du script d upgrade Moodle local.'

    try {
        $localMoodleRuntime = ConvertTo-UckkLocalFullPath -Path (
            Get-UckkLocalConfigValue -Config $Config -Path 'paths.localMoodleRuntime' -Required
        )

        $localMoodleRoot = ConvertTo-UckkLocalFullPath -Path (
            Get-UckkLocalConfigValue -Config $Config -Path 'paths.localMoodleRoot' -Required
        )

        $phpBinary = Get-UckkLocalPhpBinary -Config $Config
        $upgradeRelative = [string](Get-UckkLocalConfigValue -Config $Config -Path 'moodle.upgradeScript' -Default 'admin/cli/upgrade.php')

        $candidateRoots = [System.Collections.Generic.List[string]]::new()

        foreach ($candidate in @(
            $localMoodleRuntime,
            $localMoodleRoot,
            (Join-Path $localMoodleRoot 'public')
        )) {
            if ([string]::IsNullOrWhiteSpace([string] $candidate)) {
                continue
            }

            $candidateFull = ConvertTo-UckkLocalFullPath -Path ([string] $candidate)

            if (-not $candidateRoots.Contains($candidateFull)) {
                $candidateRoots.Add($candidateFull)
            }
        }

        $upgradeScript = ''
        $upgradeRoot = ''

        foreach ($candidateRoot in $candidateRoots) {
            $candidateScript = Join-Path $candidateRoot $upgradeRelative

            if (Test-Path -LiteralPath $candidateScript -PathType Leaf) {
                $upgradeRoot = $candidateRoot
                $upgradeScript = $candidateScript
                break
            }
        }
    }
    catch {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'base Moodle locale' `
            -DangerLevel 3 `
            -Mode 'application' `
            -Cause $_.Exception.Message `
            -NextStep 'Corriger paths.localMoodleRoot, paths.localMoodleRuntime ou moodle.localPhpPath.'
    }

    if ([string]::IsNullOrWhiteSpace($upgradeScript)) {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'base Moodle locale' `
            -DangerLevel 3 `
            -Mode 'application' `
            -Cause "Script Moodle introuvable : $upgradeRelative dans $($candidateRoots -join ', ')" `
            -NextStep 'Vérifier paths.localMoodleRuntime, paths.localMoodleRoot et moodle.upgradeScript.'
    }

    $result = Add-UckkLocalStep -Result $result -Step (
        New-UckkLocalStep `
            -Name 'Vérifier script upgrade Moodle' `
            -Status 'Réussi' `
            -Summary 'Script Moodle trouvé.' `
            -Detail $upgradeScript
    )

    $processResult = Invoke-UckkLocalProcess `
        -FilePath $phpBinary `
        -ArgumentList @($upgradeScript, '--non-interactive') `
        -WorkingDirectory $upgradeRoot `
        -TimeoutSeconds 600

    $result.data = [pscustomobject]@{
        phpBinary      = $phpBinary
        upgradeRoot    = $upgradeRoot
        upgradeScript  = $upgradeScript
        candidateRoots = @($candidateRoots)
        process        = $processResult
    }

    if (-not $processResult.success) {
        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'Exécuter upgrade Moodle local' `
                -Status 'Échoué' `
                -Summary 'La commande d upgrade Moodle local a échoué.' `
                -Detail $processResult.stderr `
                -Data $processResult
        )

        $result = Add-UckkLocalError -Result $result -ErrorMessage 'L upgrade Moodle local a échoué.'

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Échoué — Moodle local n a pas été mis à jour correctement.' `
            -NextStep 'Lire le détail technique et le rapport avant de relancer l upgrade.'
    }

    $result = Add-UckkLocalStep -Result $result -Step (
        New-UckkLocalStep `
            -Name 'Exécuter upgrade Moodle local' `
            -Status 'Réussi' `
            -Summary 'Upgrade Moodle local terminé.' `
            -Detail $processResult.stdout `
            -Data $processResult
    )

    return Complete-UckkLocalResult `
        -Result $result `
        -Summary 'Réussi — Moodle local est à jour.' `
        -NextStep 'Purger les caches locaux puis démarrer Moodle local.'
}

function Clear-UckkLocalMoodleCaches {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config,

        [Parameter()]
        [switch] $Simulation
    )

    $action = $(if ($Simulation) { 'Simulation purge caches locaux' } else { 'Purger les caches locaux' })

    $result = New-UckkLocalResult `
        -Action $action `
        -Target 'Moodle local' `
        -DangerLevel 2 `
        -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
        -Status 'En cours' `
        -Summary 'Préparation de la purge des caches locaux.'

    try {
        $localMoodleRuntime = ConvertTo-UckkLocalFullPath -Path (
            Get-UckkLocalConfigValue -Config $Config -Path 'paths.localMoodleRuntime' -Required
        )

        $localMoodleRoot = ConvertTo-UckkLocalFullPath -Path (
            Get-UckkLocalConfigValue -Config $Config -Path 'paths.localMoodleRoot' -Required
        )

        $phpBinary = Get-UckkLocalPhpBinary -Config $Config

        $candidateRoots = [System.Collections.Generic.List[string]]::new()

        foreach ($candidate in @(
            $localMoodleRuntime,
            $localMoodleRoot,
            (Join-Path $localMoodleRoot 'public')
        )) {
            if ([string]::IsNullOrWhiteSpace([string] $candidate)) {
                continue
            }

            $candidateFull = ConvertTo-UckkLocalFullPath -Path ([string] $candidate)

            if (-not $candidateRoots.Contains($candidateFull)) {
                $candidateRoots.Add($candidateFull)
            }
        }

        $purgeScript = ''
        $purgeRoot = ''

        foreach ($candidateRoot in $candidateRoots) {
            $candidateScript = Join-Path $candidateRoot 'admin/cli/purge_caches.php'

            if (Test-Path -LiteralPath $candidateScript -PathType Leaf) {
                $purgeRoot = $candidateRoot
                $purgeScript = $candidateScript
                break
            }
        }
    }
    catch {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'Moodle local' `
            -DangerLevel 2 `
            -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
            -Cause $_.Exception.Message `
            -NextStep 'Corriger la configuration Moodle locale.'
    }

    if ([string]::IsNullOrWhiteSpace($purgeScript)) {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'Moodle local' `
            -DangerLevel 2 `
            -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
            -Cause "Script Moodle introuvable : admin/cli/purge_caches.php dans $($candidateRoots -join ', ')" `
            -NextStep 'Vérifier paths.localMoodleRuntime et paths.localMoodleRoot.'
    }

    $result = Add-UckkLocalStep -Result $result -Step (
        New-UckkLocalStep `
            -Name 'Vérifier script purge caches' `
            -Status 'Réussi' `
            -Summary 'Script Moodle trouvé.' `
            -Detail $purgeScript
    )

    if ($Simulation) {
        $result.data = [pscustomobject]@{
            phpBinary      = $phpBinary
            purgeRoot      = $purgeRoot
            purgeScript    = $purgeScript
            candidateRoots = @($candidateRoots)
            wouldRun       = "$phpBinary $purgeScript"
        }

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Réussi — simulation terminée. Aucun cache Moodle local n a été purgé.' `
            -NextStep 'Lancer "Purger les caches locaux" si tout est correct.'
    }

    $processResult = Invoke-UckkLocalProcess `
        -FilePath $phpBinary `
        -ArgumentList @($purgeScript) `
        -WorkingDirectory $purgeRoot `
        -TimeoutSeconds 180

    $result.data = [pscustomobject]@{
        phpBinary      = $phpBinary
        purgeRoot      = $purgeRoot
        purgeScript    = $purgeScript
        candidateRoots = @($candidateRoots)
        process        = $processResult
    }

    if (-not $processResult.success) {
        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'Exécuter purge caches' `
                -Status 'Échoué' `
                -Summary 'La commande de purge des caches locaux a échoué.' `
                -Detail $processResult.stderr `
                -Data $processResult
        )

        $result = Add-UckkLocalError -Result $result -ErrorMessage 'La purge des caches locaux a échoué.'

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Échoué — les caches locaux n ont pas été purgés correctement.' `
            -NextStep 'Lire le détail technique, corriger Moodle local, puis relancer.'
    }

    $result = Add-UckkLocalStep -Result $result -Step (
        New-UckkLocalStep `
            -Name 'Exécuter purge caches' `
            -Status 'Réussi' `
            -Summary 'Caches Moodle locaux purgés.' `
            -Detail $processResult.stdout `
            -Data $processResult
    )

    return Complete-UckkLocalResult `
        -Result $result `
        -Summary 'Réussi — les caches Moodle locaux ont été purgés.' `
        -NextStep 'Ouvrir Moodle local et vérifier les pages concernées.'
}

function Start-UckkLocalMoodle {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config
    )

    $action = 'Démarrer Moodle local'

    $result = New-UckkLocalResult `
        -Action $action `
        -Target 'Moodle local' `
        -DangerLevel 2 `
        -Mode 'application' `
        -Status 'En cours' `
        -Summary 'Démarrage de Moodle local.'

    try {
        $baseUrl = [string] (
            Get-UckkLocalConfigValue `
                -Config $Config `
                -Path 'urls.localBase' `
                -Required
        )

        $localRuntime = ConvertTo-UckkLocalFullPath -Path (
            Get-UckkLocalConfigValue `
                -Config $Config `
                -Path 'paths.localMoodleRuntime' `
                -Required
        )

        $phpBinary = Get-UckkLocalPhpBinary -Config $Config
        $baseUri = Get-UckkLocalBaseUri -BaseUrl $baseUrl
    }
    catch {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'Moodle local' `
            -DangerLevel 2 `
            -Mode 'application' `
            -Cause $_.Exception.Message `
            -NextStep 'Corriger urls.localBase, paths.localMoodleRuntime ou moodle.localPhpPath.'
    }

    if (-not (Test-Path -LiteralPath $localRuntime -PathType Container)) {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'Moodle local' `
            -DangerLevel 2 `
            -Mode 'application' `
            -Cause "Dossier exécuté par Moodle local introuvable : $localRuntime" `
            -NextStep 'Corriger paths.localMoodleRuntime.'
    }

    $alreadyRunning = Test-UckkLocalUrlResponding `
        -Url $baseUrl `
        -TimeoutSeconds 5

    if ($alreadyRunning.success) {
        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'Vérifier Moodle local' `
                -Status 'Réussi' `
                -Summary 'Moodle local répond déjà.' `
                -Detail $baseUrl `
                -Data $alreadyRunning
        )

        $result.data = [pscustomobject]@{
            baseUrl      = $baseUrl
            localRuntime = $localRuntime
            phpBinary    = $phpBinary
            alreadyReady = $true
            check        = $alreadyRunning
        }

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary "Réussi — Moodle local répond déjà : $baseUrl" `
            -NextStep 'Ouvrir Moodle local ou tester les pages locales.'
    }

    $listenAddress = '{0}:{1}' -f $baseUri.host, $baseUri.port
    $arguments = @(
        '-S',
        $listenAddress,
        '-t',
        $localRuntime
    )

    try {
        $process = Start-UckkLocalDetachedProcess `
            -FilePath $phpBinary `
            -ArgumentList $arguments `
            -WorkingDirectory $localRuntime

        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'Lancer serveur PHP local' `
                -Status 'Réussi' `
                -Summary 'Serveur PHP local lancé.' `
                -Detail "$phpBinary $($arguments -join ' ')" `
                -Data @{
                    processId = $process.Id
                    runtime   = $localRuntime
                    baseUrl   = $baseUrl
                }
        )

        $readyCheck = Wait-UckkLocalUrlResponding `
            -Url $baseUrl `
            -TimeoutSeconds 60 `
            -DelayMilliseconds 1000 `
            -RequestTimeoutSeconds 5

        $result.data = [pscustomobject]@{
            baseUrl      = $baseUrl
            localRuntime = $localRuntime
            phpBinary    = $phpBinary
            arguments    = $arguments
            processId    = $process.Id
            readyCheck   = $readyCheck
        }

        if (-not $readyCheck.success) {
            $result = Add-UckkLocalStep -Result $result -Step (
                New-UckkLocalStep `
                    -Name 'Attendre Moodle local' `
                    -Status 'Réussi avec avertissements' `
                    -Summary 'Moodle local a été lancé, mais peut encore terminer son démarrage.' `
                    -Detail $readyCheck.detail `
                    -Data $readyCheck
            )

            $result = Add-UckkLocalWarning `
                -Result $result `
                -Warning "Moodle local a été lancé, mais ne répondait pas encore pendant la fenêtre d attente : $baseUrl"

            return Complete-UckkLocalResult `
                -Result $result `
                -Summary 'Réussi avec avertissements — Moodle local a été lancé. Il peut prendre quelques secondes avant de répondre.' `
                -NextStep 'Attendre quelques secondes, puis ouvrir Moodle local ou relancer Accueil.'
        }

        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'Attendre Moodle local' `
                -Status 'Réussi' `
                -Summary 'Moodle local répond.' `
                -Detail $baseUrl `
                -Data $readyCheck
        )

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary "Réussi — Moodle local a été démarré et répond : $baseUrl" `
            -NextStep 'Ouvrir Moodle local ou tester les pages locales.'
    }
    catch {
        $result = Add-UckkLocalError -Result $result -ErrorMessage $_.Exception.Message

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Échoué — Moodle local n a pas pu être démarré par l application.' `
            -NextStep 'Vérifier moodle.localPhpPath, le port local et paths.localMoodleRuntime.'
    }
}

function Open-UckkLocalMoodle {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config,

        [Parameter()]
        [string] $Path = '/'
    )

    $action = 'Ouvrir Moodle local'

    try {
        $baseUrl = [string] (Get-UckkLocalConfigValue -Config $Config -Path 'urls.localBase' -Required)

        if ([string]::IsNullOrWhiteSpace($Path) -or $Path -eq '/') {
            $defaultFacadeId = [string](Get-UckkLocalConfigValue -Config $Config -Path 'publicFacades.defaultId' -Default '')

            if (-not [string]::IsNullOrWhiteSpace($defaultFacadeId)) {
                $defaultFacade = Get-UckkLocalPublicFacade -Config $Config -Id $defaultFacadeId
                $defaultTheme = [string](Get-UckkLocalObjectPropertyValue -Object $defaultFacade -Name 'theme' -Default '')

                if (-not [string]::IsNullOrWhiteSpace($defaultTheme)) {
                    $Path = "/?theme=$defaultTheme"
                }
            }
        }

        $url = Resolve-UckkLocalOpenUrl -Config $Config -BaseUrl $baseUrl -Path $Path
    }
    catch {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'Moodle local' `
            -DangerLevel 0 `
            -Mode 'navigation' `
            -Cause $_.Exception.Message `
            -NextStep 'Corriger urls.localBase ou urls.localCourseIndex dans la configuration.'
    }

    $result = New-UckkLocalResult `
        -Action $action `
        -Target 'Moodle local' `
        -DangerLevel 0 `
        -Mode 'navigation' `
        -Status 'En cours' `
        -Summary "Ouverture de l URL locale : $url"

    $baseCheck = Test-UckkLocalUrlResponding `
        -Url $baseUrl `
        -TimeoutSeconds 5

    if (-not $baseCheck.success) {
        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'Vérifier Moodle local' `
                -Status 'Échoué' `
                -Summary 'Moodle local ne répond pas encore.' `
                -Detail $baseCheck.detail `
                -Data $baseCheck
        )

        $startResult = Start-UckkLocalMoodle -Config $Config

        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'Démarrer Moodle local' `
                -Status $(if ($startResult.success) { 'Réussi' } else { 'Échoué' }) `
                -Summary $startResult.summary `
                -Detail $startResult.nextStep `
                -Data $startResult
        )

        if (-not $startResult.success) {
            $result = Add-UckkLocalError `
                -Result $result `
                -ErrorMessage 'Moodle local ne répond pas et n a pas pu être démarré.'

            $result.data = [pscustomobject]@{
                baseUrl     = $baseUrl
                url         = $url
                baseCheck   = $baseCheck
                startResult = $startResult
            }

            return Complete-UckkLocalResult `
                -Result $result `
                -Summary 'Échoué — Moodle local ne répond pas.' `
                -NextStep 'Corriger PHP, le port local ou paths.localMoodleRuntime, puis relancer.'
        }

        $baseCheck = Wait-UckkLocalUrlResponding `
            -Url $baseUrl `
            -TimeoutSeconds 30 `
            -DelayMilliseconds 1000 `
            -RequestTimeoutSeconds 5
    }
    else {
        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'Vérifier Moodle local' `
                -Status 'Réussi' `
                -Summary 'Moodle local répond déjà.' `
                -Detail $baseUrl `
                -Data $baseCheck
        )
    }

    if (-not $baseCheck.success) {
        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'Attendre Moodle local' `
                -Status 'Réussi avec avertissements' `
                -Summary 'Moodle local peut encore terminer son démarrage.' `
                -Detail $baseCheck.detail `
                -Data $baseCheck
        )

        $result = Add-UckkLocalWarning `
            -Result $result `
            -Warning "Moodle local ne répondait pas encore au moment de l ouverture : $baseUrl"

        try {
            Start-Process $url

            $result = Add-UckkLocalStep -Result $result -Step (
                New-UckkLocalStep `
                    -Name 'Ouvrir navigateur' `
                    -Status 'Réussi avec avertissements' `
                    -Summary 'Navigateur ouvert pendant que Moodle local termine son démarrage.' `
                    -Detail $url
            )
        }
        catch {
            $result = Add-UckkLocalWarning `
                -Result $result `
                -Warning "Le navigateur n a pas pu être ouvert automatiquement : $($_.Exception.Message)"
        }

        $result.data = [pscustomobject]@{
            baseUrl   = $baseUrl
            url       = $url
            baseCheck = $baseCheck
        }

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Réussi avec avertissements — Moodle local a été lancé, mais pouvait encore terminer son démarrage au moment de l ouverture.' `
            -NextStep 'Attendre quelques secondes, puis vérifier ou actualiser la page dans le navigateur.'
    }

    try {
        Start-Process $url

        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'Ouvrir navigateur' `
                -Status 'Réussi' `
                -Summary 'Navigateur ouvert.' `
                -Detail $url
        )

        $result.data = [pscustomobject]@{
            baseUrl   = $baseUrl
            url       = $url
            baseCheck = $baseCheck
        }

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary "Réussi — Moodle local répond et a été ouvert : $url" `
            -NextStep 'Vérifier la page dans le navigateur.'
    }
    catch {
        $result = Add-UckkLocalError -Result $result -ErrorMessage $_.Exception.Message

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Échoué — le navigateur n a pas pu être ouvert.' `
            -NextStep 'Copier l URL locale et l ouvrir manuellement.'
    }
}

function Open-UckkLocalFacade {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config,

        [Parameter(Mandatory)]
        [string] $FacadeId
    )

    try {
        $facade = Get-UckkLocalPublicFacade -Config $Config -Id $FacadeId
        $label = [string](Get-UckkLocalObjectPropertyValue -Object $facade -Name 'label' -Default $FacadeId)
        $theme = [string](Get-UckkLocalObjectPropertyValue -Object $facade -Name 'theme' -Default '')

        if ([string]::IsNullOrWhiteSpace($theme)) {
            throw "Thème Moodle absent pour la façade $FacadeId."
        }
    }
    catch {
        return New-UckkLocalRefusedResult `
            -Action "Ouvrir façade locale : $FacadeId" `
            -Target 'Moodle local' `
            -DangerLevel 0 `
            -Mode 'navigation' `
            -Cause $_.Exception.Message `
            -NextStep 'Corriger publicFacades.sites dans la configuration.'
    }

    $openResult = Open-UckkLocalMoodle -Config $Config -Path "/?theme=$theme"

    if ($null -ne $openResult) {
        $openResult.action = "Ouvrir $label"
        $openResult.target = "façade locale $FacadeId"
        $openResult.nextStep = "Vérifier la façade $label dans le navigateur."
    }

    return $openResult
}

