function Invoke-UckkLocalProcess {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $FilePath,

        [Parameter()]
        [string[]] $ArgumentList = @(),

        [Parameter()]
        [string] $WorkingDirectory = '',

        [Parameter()]
        [int] $TimeoutSeconds = 120
    )

    $stdoutPath = [System.IO.Path]::GetTempFileName()
    $stderrPath = [System.IO.Path]::GetTempFileName()

    try {
        $process = [System.Diagnostics.Process]::new()
        $process.StartInfo.FileName = $FilePath

        foreach ($arg in $ArgumentList) {
            [void] $process.StartInfo.ArgumentList.Add($arg)
        }

        if (-not [string]::IsNullOrWhiteSpace($WorkingDirectory)) {
            $process.StartInfo.WorkingDirectory = $WorkingDirectory
        }

        $process.StartInfo.RedirectStandardOutput = $true
        $process.StartInfo.RedirectStandardError = $true
        $process.StartInfo.UseShellExecute = $false
        $process.StartInfo.CreateNoWindow = $true

        [void] $process.Start()

        $stdoutTask = $process.StandardOutput.ReadToEndAsync()
        $stderrTask = $process.StandardError.ReadToEndAsync()

        $completed = $process.WaitForExit($TimeoutSeconds * 1000)

        if (-not $completed) {
            try {
                $process.Kill($true)
            }
            catch {
                # Ignore secondary kill failure.
            }

            return [pscustomobject]@{
                success       = $false
                timedOut      = $true
                exitCode      = $null
                stdout        = ''
                stderr        = "Timeout après $TimeoutSeconds secondes."
                filePath      = $FilePath
                arguments     = $ArgumentList
                workingDir    = $WorkingDirectory
                timeoutSecond = $TimeoutSeconds
            }
        }

        return [pscustomobject]@{
            success       = ($process.ExitCode -eq 0)
            timedOut      = $false
            exitCode      = $process.ExitCode
            stdout        = $stdoutTask.Result
            stderr        = $stderrTask.Result
            filePath      = $FilePath
            arguments     = $ArgumentList
            workingDir    = $WorkingDirectory
            timeoutSecond = $TimeoutSeconds
        }
    }
    finally {
        Remove-Item -LiteralPath $stdoutPath, $stderrPath -Force -ErrorAction SilentlyContinue

    }
}


function Get-UckkLocalPhpBinary {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config
    )

    $phpBinary = [string] (
        Get-UckkLocalConfigValue `
            -Config $Config `
            -Path 'moodle.localPhpPath' `
            -Default ''
    )

    if ([string]::IsNullOrWhiteSpace($phpBinary)) {
        $phpBinary = [string] (
            Get-UckkLocalConfigValue `
                -Config $Config `
                -Path 'moodle.phpBinary' `
                -Default 'php'
        )
    }

    if ([string]::IsNullOrWhiteSpace($phpBinary)) {
        return 'php'
    }

    return $phpBinary
}

function Get-UckkLocalBaseUri {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $BaseUrl
    )

    try {
        $uri = [System.Uri]::new($BaseUrl)
    }
    catch {
        throw "URL locale invalide : $BaseUrl"
    }

    if ($uri.Scheme -ne 'http' -and $uri.Scheme -ne 'https') {
        throw "URL locale non supportée : $BaseUrl"
    }

    $port = $uri.Port

    if ($port -lt 1) {
        if ($uri.Scheme -eq 'https') {
            $port = 443
        }
        else {
            $port = 80
        }
    }

    return [pscustomobject]@{
        scheme = $uri.Scheme
        host   = $uri.Host
        port   = $port
        url    = $uri.ToString().TrimEnd('/')
    }
}

function Test-UckkLocalUrlResponding {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $Url,

        [Parameter()]
        [int] $TimeoutSeconds = 5
    )

    try {
        $response = Invoke-WebRequest `
            -Uri $Url `
            -UseBasicParsing `
            -TimeoutSec $TimeoutSeconds `
            -ErrorAction Stop

        return [pscustomobject]@{
            success    = $true
            url        = $Url
            statusCode = $response.StatusCode
            detail     = $response.StatusDescription
        }
    }
    catch {
        return [pscustomobject]@{
            success    = $false
            url        = $Url
            statusCode = $null
            detail     = $_.Exception.Message
        }
    }
}

function Wait-UckkLocalUrlResponding {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $Url,

        [Parameter()]
        [int] $TimeoutSeconds = 60,

        [Parameter()]
        [int] $DelayMilliseconds = 1000,

        [Parameter()]
        [int] $RequestTimeoutSeconds = 5
    )

    $deadline = (Get-Date).AddSeconds($TimeoutSeconds)
    $lastCheck = $null

    do {
        $lastCheck = Test-UckkLocalUrlResponding `
            -Url $Url `
            -TimeoutSeconds $RequestTimeoutSeconds

        if ($lastCheck.success) {
            return $lastCheck
        }

        Start-Sleep -Milliseconds $DelayMilliseconds
    }
    while ((Get-Date) -lt $deadline)

    return $lastCheck
}

function Resolve-UckkLocalOpenUrl {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config,

        [Parameter(Mandatory)]
        [string] $BaseUrl,

        [Parameter()]
        [string] $Path = '/'
    )

    $normalizedPath = [string] $Path

    if ([string]::IsNullOrWhiteSpace($normalizedPath) -or $normalizedPath -eq '/') {
        return ($BaseUrl.TrimEnd('/') + '/')
    }

    if ($normalizedPath -match '^https?://') {
        return $normalizedPath
    }

    return Join-UckkLocalUrl -BaseUrl $BaseUrl -Path $normalizedPath
}

function Start-UckkLocalDetachedProcess {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $FilePath,

        [Parameter()]
        [string[]] $ArgumentList = @(),

        [Parameter(Mandatory)]
        [string] $WorkingDirectory
    )

    $process = Start-Process `
        -FilePath $FilePath `
        -ArgumentList $ArgumentList `
        -WorkingDirectory $WorkingDirectory `
        -WindowStyle Minimized `
        -PassThru

    return $process
}

