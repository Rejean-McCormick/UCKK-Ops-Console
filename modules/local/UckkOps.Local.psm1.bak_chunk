#Requires -Version 7.0
Set-StrictMode -Off
<#
.SYNOPSIS
  Local operations for UCKK Ops Console.

.DESCRIPTION
  This module manages local-only actions:

    - verify local paths;
    - sync source code to local Moodle runtime;
    - purge local Moodle caches;
    - start local Moodle if configured;
    - open local Moodle;
    - test local pages.

  Contract:
    - This module must not modify the server.
    - This module must not write to the server Moodle database.
    - This module must not run recovery tools.
    - This module must not use hardcoded project paths.
    - All paths and URLs must come from configuration.
    - Public functions must return ActionResult-compatible objects.
#>

# ---------------------------------------------------------------------------
# Private helpers — config
# ---------------------------------------------------------------------------

function Get-UckkLocalConfigValue {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config,

        [Parameter(Mandatory)]
        [string] $Path,

        [Parameter()]
        [switch] $Required,

        [Parameter()]
        [AllowNull()]
        [object] $Default = $null
    )

    $current = $Config

    foreach ($part in ($Path -split '\.')) {
        if ($null -eq $current) {
            if ($Required) {
                throw "Configuration manquante : $Path"
            }

            return $Default
        }

        if ($current -is [hashtable]) {
            if (-not $current.ContainsKey($part)) {
                if ($Required) {
                    throw "Configuration manquante : $Path"
                }

                return $Default
            }

            $current = $current[$part]
            continue
        }

        $property = $current.PSObject.Properties[$part]

        if ($null -eq $property) {
            if ($Required) {
                throw "Configuration manquante : $Path"
            }

            return $Default
        }

        $current = $property.Value
    }

    if ($Required -and ($null -eq $current -or [string]::IsNullOrWhiteSpace([string] $current))) {
        throw "Configuration vide : $Path"
    }

    if ($null -eq $current) {
        return $Default
    }

    return $current
}

function ConvertTo-UckkLocalFullPath {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $Path
    )

    return [System.IO.Path]::GetFullPath(
        [Environment]::ExpandEnvironmentVariables($Path)
    )
}

function Test-UckkLocalPathInside {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $ChildPath,

        [Parameter(Mandatory)]
        [string] $ParentPath
    )

    $child = ConvertTo-UckkLocalFullPath -Path $ChildPath
    $parent = ConvertTo-UckkLocalFullPath -Path $ParentPath

    if (-not $parent.EndsWith([System.IO.Path]::DirectorySeparatorChar)) {
        $parent += [System.IO.Path]::DirectorySeparatorChar
    }

    return $child.StartsWith($parent, [System.StringComparison]::OrdinalIgnoreCase)
}

function Join-UckkLocalUrl {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $BaseUrl,

        [Parameter()]
        [string] $Path = '/'
    )

    $base = $BaseUrl.TrimEnd('/')

    if ([string]::IsNullOrWhiteSpace($Path)) {
        return $base
    }

    if ($Path.StartsWith('/')) {
        return "$base$Path"
    }

    return "$base/$Path"
}

# ---------------------------------------------------------------------------
# Private helpers — results
# ---------------------------------------------------------------------------

function Get-UckkLocalObjectPropertyValue {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Object,

        [Parameter(Mandatory)]
        [string] $Name,

        [Parameter()]
        [AllowNull()]
        [object] $Default = $null
    )

    if ($null -eq $Object) {
        return $Default
    }

    $property = $Object.PSObject.Properties[$Name]

    if ($null -eq $property) {
        return $Default
    }

    if ($null -eq $property.Value) {
        return $Default
    }

    return $property.Value
}

function Get-UckkLocalListCount {
    [CmdletBinding()]
    param(
        [Parameter()]
        [AllowNull()]
        [object] $Value
    )

    if ($null -eq $Value) {
        return 0
    }

    if ($Value -is [string]) {
        if ([string]::IsNullOrWhiteSpace($Value)) {
            return 0
        }

        return 1
    }

    $countProperty = $Value.PSObject.Properties['Count']

    if ($null -ne $countProperty) {
        try {
            return [int] $countProperty.Value
        }
        catch {
            # Fall through to enumeration.
        }
    }

    if ($Value -is [System.Collections.IEnumerable]) {
        $count = 0

        foreach ($item in $Value) {
            $count++
        }

        return $count
    }

    return 1
}

function Get-UckkLocalResultListCount {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Result,

        [Parameter(Mandatory)]
        [string] $PropertyName
    )

    $value = Get-UckkLocalObjectPropertyValue -Object $Result -Name $PropertyName -Default @()

    return Get-UckkLocalListCount -Value $value
}

function New-UckkLocalStep {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $Name,

        [Parameter()]
        [ValidateSet(
            'Non lancée',
            'En cours',
            'Réussi',
            'Réussi avec avertissements',
            'Échoué',
            'Ignoré',
            'Annulé'
        )]
        [string] $Status = 'Non lancée',

        [Parameter()]
        [string] $Summary = '',

        [Parameter()]
        [string] $Detail = '',

        [Parameter()]
        [AllowNull()]
        [object] $Data = $null
    )

    if (Get-Command -Name New-UckkActionStep -ErrorAction SilentlyContinue) {
        return New-UckkActionStep `
            -Name $Name `
            -Status $Status `
            -Summary $Summary `
            -Detail $Detail `
            -Data $Data
    }

    return [pscustomobject]@{
        name      = $Name
        status    = $Status
        summary   = $Summary
        detail    = $Detail
        data      = $Data
        timestamp = (Get-Date).ToString('yyyy-MM-dd HH:mm:ss')
    }
}

function New-UckkLocalResult {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $Action,

        [Parameter()]
        [string] $Target = 'local',

        [Parameter()]
        [ValidateRange(0, 7)]
        [int] $DangerLevel = 1,

        [Parameter()]
        [ValidateSet(
            'navigation',
            'vérification',
            'simulation',
            'application',
            'publication',
            'récupération',
            'test',
            'annulation'
        )]
        [string] $Mode = 'vérification',

        [Parameter()]
        [ValidateSet(
            'Prêt',
            'En cours',
            'Réussi',
            'Réussi avec avertissements',
            'Échoué',
            'Annulé',
            'À vérifier dans le navigateur'
        )]
        [string] $Status = 'Prêt',

        [Parameter()]
        [bool] $Success = $false,

        [Parameter()]
        [string] $Summary = '',

        [Parameter()]
        [string] $NextStep = '',

        [Parameter()]
        [AllowNull()]
        [object] $Data = $null
    )

    if (Get-Command -Name New-UckkActionResult -ErrorAction SilentlyContinue) {
        return New-UckkActionResult `
            -Action $Action `
            -Domain 'local' `
            -Target $Target `
            -DangerLevel $DangerLevel `
--- CHUNK END ---

            -Mode $Mode `
            -Status $Status `
            -Success $Success `
            -Summary $Summary `
            -NextStep $NextStep `
            -Data $Data
    }

    return [pscustomobject]@{
        success         = $Success
        status          = $Status
        action          = $Action
        domain          = 'local'
        target          = $Target
        dangerLevel     = $DangerLevel
        mode            = $Mode
        summary         = $Summary
        warnings        = [System.Collections.ArrayList]::new()
        errors          = [System.Collections.ArrayList]::new()
        nextStep        = $NextStep
        reportPath      = ''
        logPath         = ''
        data            = $Data
        steps           = [System.Collections.ArrayList]::new()
        startedAt       = (Get-Date).ToString('yyyy-MM-dd HH:mm:ss')
        finishedAt      = ''
        durationSeconds = $null
    }
}

function Add-UckkLocalStep {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [psobject] $Result,

        [Parameter(Mandatory)]
        [psobject] $Step
    )

    if (Get-Command -Name Add-UckkActionStep -ErrorAction SilentlyContinue) {
        return Add-UckkActionStep -Result $Result -Step $Step
    }

    if ($null -eq $Result.steps) {
        $Result.steps = [System.Collections.ArrayList]::new()
    }

    [void] $Result.steps.Add($Step)

    return $Result
}

function Add-UckkLocalWarning {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [psobject] $Result,

        [Parameter(Mandatory)]
        [string] $Warning
    )

    if (Get-Command -Name Add-UckkActionWarning -ErrorAction SilentlyContinue) {
        return Add-UckkActionWarning -Result $Result -Warning $Warning
    }

    if ($null -eq $Result.warnings) {
        $Result.warnings = [System.Collections.ArrayList]::new()
    }

    [void] $Result.warnings.Add($Warning)

    if ($Result.status -eq 'Réussi') {
        $Result.status = 'Réussi avec avertissements'
    }

    return $Result
}

function Add-UckkLocalError {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [psobject] $Result,

        [Parameter(Mandatory)]
        [string] $ErrorMessage
    )


    if (Get-Command -Name Add-UckkActionError -ErrorAction SilentlyContinue) {
        return Add-UckkActionError -Result $Result -ErrorMessage $ErrorMessage
    }

    if ($null -eq $Result.errors) {
        $Result.errors = [System.Collections.ArrayList]::new()
    }

    [void] $Result.errors.Add($ErrorMessage)

    $Result.success = $false
    $Result.status = 'Échoué'

    return $Result
}

function Complete-UckkLocalResult {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [psobject] $Result,

        [Parameter()]
        [string] $Summary = '',

        [Parameter()]
        [string] $NextStep = '',

        [Parameter()]
        [string] $ReportPath = '',

        [Parameter()]
        [string] $LogPath = ''
    )

    if (Get-Command -Name Complete-UckkActionResult -ErrorAction SilentlyContinue) {
        return Complete-UckkActionResult `
            -Result $Result `
            -Summary $Summary `
            -NextStep $NextStep `
            -ReportPath $ReportPath `
            -LogPath $LogPath
    }

    if (-not [string]::IsNullOrWhiteSpace($Summary)) {
        $Result.summary = $Summary
    }

    if (-not [string]::IsNullOrWhiteSpace($NextStep)) {
        $Result.nextStep = $NextStep
    }

    if (-not [string]::IsNullOrWhiteSpace($ReportPath)) {
        $Result.reportPath = $ReportPath
    }

    if (-not [string]::IsNullOrWhiteSpace($LogPath)) {
        $Result.logPath = $LogPath
    }

    $Result.finishedAt = (Get-Date).ToString('yyyy-MM-dd HH:mm:ss')

    if ((Get-UckkLocalResultListCount -Result $Result -PropertyName 'errors') -gt 0) {
        $Result.status = 'Échoué'
        $Result.success = $false
    }
    elseif ((Get-UckkLocalResultListCount -Result $Result -PropertyName 'warnings') -gt 0) {
        $Result.status = 'Réussi avec avertissements'
        $Result.success = $true
    }
    elseif ($Result.status -eq 'Prêt' -or $Result.status -eq 'En cours') {
        $Result.status = 'Réussi'
        $Result.success = $true
    }

    return $Result
}

function New-UckkLocalRefusedResult {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $Action,

        [Parameter(Mandatory)]
        [string] $Target,

        [Parameter()]
        [ValidateRange(0, 7)]
        [int] $DangerLevel = 1,

        [Parameter()]
        [ValidateSet(
            'navigation',
            'vérification',
            'simulation',
            'application',
            'publication',
            'récupération',
            'test',
            'annulation'
        )]
        [string] $Mode = 'vérification',

        [Parameter(Mandatory)]
        [string] $Cause,

        [Parameter()]
        [string] $NextStep = 'Corriger la condition indiquée, puis relancer.'
    )

    if (Get-Command -Name New-UckkRefusedResult -ErrorAction SilentlyContinue) {
        return New-UckkRefusedResult `
            -Action $Action `
            -Domain 'local' `
            -Target $Target `
            -DangerLevel $DangerLevel `
            -Mode $Mode `
            -Cause $Cause `
            -NextStep $NextStep
    }

    $result = New-UckkLocalResult `
        -Action $Action `
        -Target $Target `
        -DangerLevel $DangerLevel `
        -Mode $Mode `
        -Status 'Échoué' `
        -Success $false `
        -Summary "Action refusée.`nCause : $Cause`nProchaine étape : $NextStep" `
        -NextStep $NextStep

    [void] $result.errors.Add($Cause)

    return $result
}

# ---------------------------------------------------------------------------
# Private helpers — filesystem
# ---------------------------------------------------------------------------

function Test-UckkLocalSyncExcluded {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $RelativePath
    )

    $normalized = $RelativePath.Replace('\', '/')

    $excludedRootNames = @(
        '.git',
        '.github',
        '.idea',
        '.vscode',
        'node_modules',
        'reports',
        'logs',
        'legacy',
        'recovery',
        'backups',
        'tmp',
        'temp'
    )

    foreach ($name in $excludedRootNames) {
        if ($normalized -eq $name -or $normalized.StartsWith("$name/")) {
            return $true
        }
    }

    $leaf = [System.IO.Path]::GetFileName($RelativePath)

    $excludedExactFiles = @(
        '.env',
        'config.php'
    )

    if ($excludedExactFiles -contains $leaf) {
        return $true
    }

    $excludedExtensions = @(
        '.sql',
        '.bak',
        '.backup',
        '.dump',
        '.zip',
        '.7z',
        '.rar',
        '.log',
        '.tmp'
    )

    $extension = [System.IO.Path]::GetExtension($leaf)

    if ($excludedExtensions -contains $extension) {
        return $true
    }

    return $false
}

function Copy-UckkLocalTree {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $SourceDir,

        [Parameter(Mandatory)]
        [string] $TargetDir,

        [Parameter()]
        [switch] $Simulation
    )

    $sourceFull = ConvertTo-UckkLocalFullPath -Path $SourceDir
    $targetFull = ConvertTo-UckkLocalFullPath -Path $TargetDir

    $files = Get-ChildItem -LiteralPath $sourceFull -Recurse -File -Force

    $copied = 0
    $skipped = 0
    $failed = 0
    $failures = [System.Collections.Generic.List[string]]::new()

    foreach ($file in $files) {
        $relative = [System.IO.Path]::GetRelativePath($sourceFull, $file.FullName)

        if (Test-UckkLocalSyncExcluded -RelativePath $relative) {
            $skipped++
            continue
        }

        $destination = Join-Path $targetFull $relative
        $destinationDir = Split-Path -Parent $destination

        try {
            if (-not $Simulation) {
                if (-not (Test-Path -LiteralPath $destinationDir)) {
                    New-Item -ItemType Directory -Path $destinationDir -Force | Out-Null
                }

                Copy-Item `
                    -LiteralPath $file.FullName `
                    -Destination $destination `
                    -Force
            }

            $copied++
        }
        catch {
            $failed++
            $failures.Add("$relative — $($_.Exception.Message)")
        }
    }

    return [pscustomobject]@{
        source       = $sourceFull
--- CHUNK END ---

        target       = $targetFull
        simulation   = [bool] $Simulation
        copied       = $copied
        skipped      = $skipped
        failed       = $failed
        failureItems = $failures
    }
}

# ---------------------------------------------------------------------------
# Private helpers — process and web
# ---------------------------------------------------------------------------

function Invoke-UckkLocalProcess {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $FilePath,

        [Parameter()]
        [string[]] $ArgumentList = @(),

        [Parameter()]
        [string] $WorkingDirectory = '',

        [Parameter()]
        [int] $TimeoutSeconds = 120
    )

    $stdoutPath = [System.IO.Path]::GetTempFileName()
    $stderrPath = [System.IO.Path]::GetTempFileName()

    try {
        $process = [System.Diagnostics.Process]::new()
        $process.StartInfo.FileName = $FilePath

        foreach ($arg in $ArgumentList) {
            [void] $process.StartInfo.ArgumentList.Add($arg)
        }

        if (-not [string]::IsNullOrWhiteSpace($WorkingDirectory)) {
            $process.StartInfo.WorkingDirectory = $WorkingDirectory
        }

        $process.StartInfo.RedirectStandardOutput = $true
        $process.StartInfo.RedirectStandardError = $true
        $process.StartInfo.UseShellExecute = $false
        $process.StartInfo.CreateNoWindow = $true

        [void] $process.Start()

        $stdoutTask = $process.StandardOutput.ReadToEndAsync()
        $stderrTask = $process.StandardError.ReadToEndAsync()

        $completed = $process.WaitForExit($TimeoutSeconds * 1000)

        if (-not $completed) {
            try {
                $process.Kill($true)
            }
            catch {
                # Ignore secondary kill failure.
            }

            return [pscustomobject]@{
                success       = $false
                timedOut      = $true
                exitCode      = $null
                stdout        = ''
                stderr        = "Timeout après $TimeoutSeconds secondes."
                filePath      = $FilePath
                arguments     = $ArgumentList
                workingDir    = $WorkingDirectory
                timeoutSecond = $TimeoutSeconds
            }
        }

        return [pscustomobject]@{
            success       = ($process.ExitCode -eq 0)
            timedOut      = $false
            exitCode      = $process.ExitCode
            stdout        = $stdoutTask.Result
            stderr        = $stderrTask.Result
            filePath      = $FilePath
            arguments     = $ArgumentList
            workingDir    = $WorkingDirectory
            timeoutSecond = $TimeoutSeconds
        }
    }
    finally {
        Remove-Item -LiteralPath $stdoutPath, $stderrPath -Force -ErrorAction SilentlyContinue

    }
}

# ---------------------------------------------------------------------------
# Public actions
# ---------------------------------------------------------------------------

function Test-UckkLocalPaths {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config
    )

    $action = 'Vérifier les chemins locaux'

    $result = New-UckkLocalResult `
        -Action $action `
        -Target 'local' `
        -DangerLevel 1 `
        -Mode 'vérification' `
        -Status 'En cours' `
        -Summary 'Vérification des chemins locaux en cours.'

    $checks = [System.Collections.Generic.List[object]]::new()

    $items = @(
        @{ label = 'Racine de l application'; path = 'app.root'; required = $false; type = 'directory' },
        @{ label = 'Source Git locale'; path = 'paths.uckkMoodleSource'; required = $true; type = 'directory' },
        @{ label = 'Moodle local'; path = 'paths.localMoodleRoot'; required = $true; type = 'directory' },
        @{ label = 'Dossier exécuté par Moodle local'; path = 'paths.localMoodleRuntime'; required = $true; type = 'directory' },
        @{ label = 'Dossier des rapports'; path = 'reports.dir'; required = $false; type = 'directory' },
        @{ label = 'Dossier des logs'; path = 'logs.dir'; required = $false; type = 'directory' }
    )

    foreach ($item in $items) {
        try {
            $value = Get-UckkLocalConfigValue `
                -Config $Config `
                -Path $item.path `
                -Required:([bool] $item.required)

            if ($null -eq $value -or [string]::IsNullOrWhiteSpace([string] $value)) {
                $checks.Add([pscustomobject]@{
                    label  = $item.label
                    key    = $item.path
                    path   = ''
                    exists = $false
                    status = 'Ignoré'
                    detail = 'Non configuré.'
                })

                continue
            }

            $fullPath = ConvertTo-UckkLocalFullPath -Path ([string] $value)
            $exists = Test-Path -LiteralPath $fullPath

            $checks.Add([pscustomobject]@{
                label  = $item.label
                key    = $item.path
                path   = $fullPath
                exists = $exists
                status = $(if ($exists) { 'Réussi' } else { 'Échoué' })
                detail = $(if ($exists) { 'Chemin trouvé.' } else { 'Chemin introuvable.' })
            })

            if ($exists) {
                $result = Add-UckkLocalStep -Result $result -Step (
                    New-UckkLocalStep `
                        -Name $item.label `
                        -Status 'Réussi' `
                        -Summary 'Chemin trouvé.' `
                        -Detail $fullPath
                )
            }
            else {
                $result = Add-UckkLocalStep -Result $result -Step (
                    New-UckkLocalStep `
                        -Name $item.label `
                        -Status 'Échoué' `
                        -Summary 'Chemin introuvable.' `
                        -Detail $fullPath
                )

                if ($item.required) {
                    $result = Add-UckkLocalError -Result $result -ErrorMessage "$($item.label) introuvable : $fullPath"
                }
                else {
                    $result = Add-UckkLocalWarning -Result $result -Warning "$($item.label) introuvable : $fullPath"
                }
            }
        }
        catch {
            $message = $_.Exception.Message

            $checks.Add([pscustomobject]@{
                label  = $item.label
                key    = $item.path
                path   = ''
                exists = $false
                status = 'Échoué'
                detail = $message
            })

            $result = Add-UckkLocalError -Result $result -ErrorMessage $message
            $result = Add-UckkLocalStep -Result $result -Step (
                New-UckkLocalStep `
                    -Name $item.label `
                    -Status 'Échoué' `
                    -Summary $message
            )
        }
    }

    try {
        $localUrl = Get-UckkLocalConfigValue -Config $Config -Path 'urls.localBase' -Required

        $checks.Add([pscustomobject]@{
            label  = 'URL locale'
            key    = 'urls.localBase'
            path   = [string] $localUrl
            exists = $true
            status = 'Réussi'
            detail = 'URL configurée.'
        })

        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'URL locale' `
                -Status 'Réussi' `
                -Summary 'URL configurée.' `
                -Detail ([string] $localUrl)
        )
    }
    catch {
        $result = Add-UckkLocalError -Result $result -ErrorMessage $_.Exception.Message
    }

    $result.data = [pscustomobject]@{
        checks = $checks
    }

    if ((Get-UckkLocalResultListCount -Result $result -PropertyName 'errors') -gt 0) {
        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Échoué — un ou plusieurs chemins locaux obligatoires sont absents.' `
            -NextStep 'Corriger la configuration ou créer les dossiers nécessaires.'
    }

    if ((Get-UckkLocalResultListCount -Result $result -PropertyName 'warnings') -gt 0) {
        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Réussi avec avertissements — les chemins locaux obligatoires sont présents.' `
            -NextStep 'Lire les avertissements avant de continuer.'
    }

    return Complete-UckkLocalResult `
        -Result $result `
        -Summary 'Réussi — les chemins locaux obligatoires sont présents.' `
        -NextStep 'Synchroniser source vers Moodle local si nécessaire.'
}

function Sync-UckkSourceToLocalMoodle {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config,

        [Parameter()]
        [switch] $Simulation
    )

    $action = $(if ($Simulation) { 'Simulation synchronisation source vers Moodle local' } else { 'Synchroniser source vers Moodle local' })

    $result = New-UckkLocalResult `
        -Action $action `
        -Target 'dossier exécuté par Moodle local' `
        -DangerLevel 2 `
        -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
        -Status 'En cours' `
        -Summary 'Synchronisation locale en cours.'

    try {
        $source = ConvertTo-UckkLocalFullPath -Path (
            Get-UckkLocalConfigValue -Config $Config -Path 'paths.uckkMoodleSource' -Required
        )

        $localMoodleRoot = ConvertTo-UckkLocalFullPath -Path (
            Get-UckkLocalConfigValue -Config $Config -Path 'paths.localMoodleRoot' -Required
        )

        $target = ConvertTo-UckkLocalFullPath -Path (
            Get-UckkLocalConfigValue -Config $Config -Path 'paths.localMoodleRuntime' -Required
        )
    }
    catch {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'dossier exécuté par Moodle local' `
            -DangerLevel 2 `
            -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
            -Cause $_.Exception.Message `
            -NextStep 'Corriger la configuration des chemins locaux.'
    }

    if (-not (Test-Path -LiteralPath $source -PathType Container)) {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'dossier exécuté par Moodle local' `
            -DangerLevel 2 `
            -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
            -Cause "Source locale introuvable : $source" `
            -NextStep 'Vérifier paths.uckkMoodleSource.'
    }

    if (-not (Test-Path -LiteralPath $target -PathType Container)) {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'dossier exécuté par Moodle local' `
            -DangerLevel 2 `
            -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
            -Cause "Dossier exécuté par Moodle local introuvable : $target" `
            -NextStep 'Vérifier paths.localMoodleRuntime.'
    }

    if (-not (Test-UckkLocalPathInside -ChildPath $target -ParentPath $localMoodleRoot)) {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'dossier exécuté par Moodle local' `
            -DangerLevel 2 `
            -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
            -Cause "La cible locale n est pas située dans le Moodle local configuré : $target" `
            -NextStep 'Vérifier paths.localMoodleRoot et paths.localMoodleRuntime.'
    }

    if ($source -eq $target) {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'dossier exécuté par Moodle local' `
            -DangerLevel 2 `
            -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
            -Cause 'La source et la cible sont identiques.' `
            -NextStep 'Corriger la configuration avant de synchroniser.'
    }

    $result = Add-UckkLocalStep -Result $result -Step (
        New-UckkLocalStep `
            -Name 'Vérifier source locale' `
            -Status 'Réussi' `
            -Summary 'Source locale trouvée.' `
            -Detail $source
    )

    $result = Add-UckkLocalStep -Result $result -Step (
        New-UckkLocalStep `
            -Name 'Vérifier cible Moodle locale' `
            -Status 'Réussi' `
--- CHUNK END ---

            -Summary 'Cible locale trouvée.' `
            -Detail $target
    )

    try {
        $copyResult = Copy-UckkLocalTree `
            -SourceDir $source `
            -TargetDir $target `
            -Simulation:$Simulation

        $result.data = $copyResult

        if ($copyResult.failed -gt 0) {
            foreach ($failure in $copyResult.failureItems) {
                $result = Add-UckkLocalError -Result $result -ErrorMessage $failure
            }

            $result = Add-UckkLocalStep -Result $result -Step (
                New-UckkLocalStep `
                    -Name 'Copier fichiers' `
                    -Status 'Échoué' `
                    -Summary "$($copyResult.failed) fichier(s) en échec." `
                    -Data $copyResult
            )

            return Complete-UckkLocalResult `
                -Result $result `
                -Summary 'Échoué — la synchronisation locale n est pas complète.' `
                -NextStep 'Lire les erreurs, corriger les fichiers concernés, puis relancer.'
        }

        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name $(if ($Simulation) { 'Simuler copie fichiers' } else { 'Copier fichiers' }) `
                -Status 'Réussi' `
                -Summary "$($copyResult.copied) fichier(s) traité(s), $($copyResult.skipped) ignoré(s)." `
                -Data $copyResult
        )

        if ($Simulation) {
            return Complete-UckkLocalResult `
                -Result $result `
                -Summary "Réussi — simulation terminée. Aucune donnée locale n a été modifiée. $($copyResult.copied) fichier(s) seraient copiés, $($copyResult.skipped) ignoré(s)." `
                -NextStep 'Lancer "Synchroniser source vers Moodle local" si tout est correct.'
        }

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary "Réussi — la source a été copiée vers Moodle local. $($copyResult.copied) fichier(s) copiés, $($copyResult.skipped) ignoré(s)." `
            -NextStep 'Purger les caches locaux, puis ouvrir Moodle local.'
    }
    catch {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'dossier exécuté par Moodle local' `
            -DangerLevel 2 `
            -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
            -Cause $_.Exception.Message `
            -NextStep 'Lire le détail technique et corriger la cause.'
    }
}

function Clear-UckkLocalMoodleCaches {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config,

        [Parameter()]
        [switch] $Simulation
    )

    $action = $(if ($Simulation) { 'Simulation purge caches locaux' } else { 'Purger les caches locaux' })

    $result = New-UckkLocalResult `
        -Action $action `
        -Target 'Moodle local' `
        -DangerLevel 2 `
        -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
        -Status 'En cours' `
        -Summary 'Préparation de la purge des caches locaux.'

    try {
        $localMoodleRoot = ConvertTo-UckkLocalFullPath -Path (
            Get-UckkLocalConfigValue -Config $Config -Path 'paths.localMoodleRoot' -Required
        )

        $phpBinary = [string] (
            Get-UckkLocalConfigValue -Config $Config -Path 'moodle.phpBinary' -Default 'php'
        )

        $purgeScript = Join-Path $localMoodleRoot 'admin/cli/purge_caches.php'

    }
    catch {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'Moodle local' `
            -DangerLevel 2 `
            -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
            -Cause $_.Exception.Message `
            -NextStep 'Corriger la configuration Moodle locale.'
    }

    if (-not (Test-Path -LiteralPath $purgeScript -PathType Leaf)) {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'Moodle local' `
            -DangerLevel 2 `
            -Mode $(if ($Simulation) { 'simulation' } else { 'application' }) `
            -Cause "Script Moodle introuvable : $purgeScript" `
            -NextStep 'Vérifier paths.localMoodleRoot.'
    }

    $result = Add-UckkLocalStep -Result $result -Step (
        New-UckkLocalStep `
            -Name 'Vérifier script purge caches' `
            -Status 'Réussi' `
            -Summary 'Script Moodle trouvé.' `
            -Detail $purgeScript
    )

    if ($Simulation) {
        $result.data = [pscustomobject]@{
            phpBinary   = $phpBinary
            purgeScript = $purgeScript
            wouldRun    = "$phpBinary $purgeScript"
        }

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Réussi — simulation terminée. Aucun cache Moodle local n a été purgé.' `
            -NextStep 'Lancer "Purger les caches locaux" si tout est correct.'
    }

    $processResult = Invoke-UckkLocalProcess `
        -FilePath $phpBinary `
        -ArgumentList @($purgeScript) `
        -WorkingDirectory $localMoodleRoot `
        -TimeoutSeconds 180

    $result.data = $processResult

    if (-not $processResult.success) {
        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'Exécuter purge caches' `
                -Status 'Échoué' `
                -Summary 'La commande de purge des caches locaux a échoué.' `
                -Detail $processResult.stderr `
                -Data $processResult
        )

        $result = Add-UckkLocalError -Result $result -ErrorMessage 'La purge des caches locaux a échoué.'

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Échoué — les caches locaux n ont pas été purgés correctement.' `
            -NextStep 'Lire le détail technique, corriger Moodle local, puis relancer.'
    }

    $result = Add-UckkLocalStep -Result $result -Step (
        New-UckkLocalStep `
            -Name 'Exécuter purge caches' `
            -Status 'Réussi' `
            -Summary 'Caches Moodle locaux purgés.' `
            -Detail $processResult.stdout `
            -Data $processResult
    )

    return Complete-UckkLocalResult `
        -Result $result `
        -Summary 'Réussi — les caches Moodle locaux ont été purgés.' `
        -NextStep 'Ouvrir Moodle local et vérifier les pages concernées.'
}

function Start-UckkLocalMoodle {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config
    )

    $action = 'Démarrer Moodle local'

    $result = New-UckkLocalResult `
        -Action $action `
        -Target 'Moodle local' `
        -DangerLevel 2 `
        -Mode 'application' `
        -Status 'En cours' `
        -Summary 'Démarrage de Moodle local.'

    $command = Get-UckkLocalConfigValue `
        -Config $Config `
        -Path 'moodle.localStartCommand' `
        -Default ''

    if ([string]::IsNullOrWhiteSpace([string] $command)) {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'Moodle local' `
            -DangerLevel 2 `
            -Mode 'application' `
            -Cause 'Aucune commande de démarrage Moodle local n est configurée.' `
            -NextStep 'Configurer moodle.localStartCommand ou démarrer Moodle local manuellement.'
    }

    try {
        Start-Process `
            -FilePath 'powershell.exe' `
            -ArgumentList @(
                '-NoProfile',
                '-ExecutionPolicy',
                'Bypass',
                '-Command',
                [string] $command
            ) `
            -WindowStyle Normal

        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'Lancer commande de démarrage' `
                -Status 'Réussi' `
                -Summary 'Commande de démarrage envoyée.' `
                -Detail ([string] $command)
        )

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Réussi — la commande de démarrage Moodle local a été lancée.' `
            -NextStep 'Attendre que Moodle local soit prêt, puis lancer "Ouvrir Moodle local" ou "Tester les pages locales".'
    }
    catch {
        $result = Add-UckkLocalError -Result $result -ErrorMessage $_.Exception.Message

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Échoué — Moodle local n a pas pu être démarré par l application.' `
            -NextStep 'Démarrer Moodle local manuellement ou corriger moodle.localStartCommand.'
    }
}

function Open-UckkLocalMoodle {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config,

        [Parameter()]
        [string] $Path = '/'
    )

    $action = 'Ouvrir Moodle local'

    try {
        $baseUrl = [string] (Get-UckkLocalConfigValue -Config $Config -Path 'urls.localBase' -Required)
        $url = Join-UckkLocalUrl -BaseUrl $baseUrl -Path $Path
    }
    catch {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'Moodle local' `
            -DangerLevel 0 `
            -Mode 'navigation' `
            -Cause $_.Exception.Message `
            -NextStep 'Corriger urls.localBase dans la configuration.'
    }

    $result = New-UckkLocalResult `
        -Action $action `
        -Target 'Moodle local' `
        -DangerLevel 0 `
        -Mode 'navigation' `
        -Status 'En cours' `
        -Summary "Ouverture de l URL locale : $url"

    try {
        Start-Process $url

        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'Ouvrir navigateur' `
                -Status 'Réussi' `
                -Summary 'Navigateur ouvert.' `
                -Detail $url
        )

        $result.data = [pscustomobject]@{
            url = $url
        }

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary "Réussi — Moodle local a été ouvert : $url" `
            -NextStep 'Vérifier la page dans le navigateur.'
    }
    catch {
        $result = Add-UckkLocalError -Result $result -ErrorMessage $_.Exception.Message

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Échoué — le navigateur n a pas pu être ouvert.' `
            -NextStep 'Copier l URL locale et l ouvrir manuellement.'
    }
}

function Test-UckkLocalPages {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config,

        [Parameter()]
        [string[]] $Paths = @(
            '/',
            '/course/index.php',
            '/local/uckk/mediatheque.php'
        ),

        [Parameter()]
        [int] $TimeoutSeconds = 15
    )

    $action = 'Tester les pages locales'

    try {
        $baseUrl = [string] (Get-UckkLocalConfigValue -Config $Config -Path 'urls.localBase' -Required)
    }
    catch {
        return New-UckkLocalRefusedResult `
            -Action $action `
            -Target 'Moodle local' `
            -DangerLevel 1 `
            -Mode 'test' `
            -Cause $_.Exception.Message `
            -NextStep 'Corriger urls.localBase dans la configuration.'
    }

    $result = New-UckkLocalResult `
        -Action $action `
        -Target 'Moodle local' `
        -DangerLevel 1 `
        -Mode 'test' `
        -Status 'En cours' `
        -Summary 'Test des pages locales en cours.'

    $pageResults = [System.Collections.Generic.List[object]]::new()

    foreach ($path in $Paths) {
--- CHUNK END ---

        $url = Join-UckkLocalUrl -BaseUrl $baseUrl -Path $path

        try {
            $response = Invoke-WebRequest `
                -Uri $url `
                -UseBasicParsing `
                -TimeoutSec $TimeoutSeconds `
                -ErrorAction Stop

            $ok = ($response.StatusCode -ge 200 -and $response.StatusCode -lt 400)

            $pageData = [pscustomobject]@{
                path       = $path
                url        = $url
                statusCode = $response.StatusCode
                success    = $ok
                detail     = $response.StatusDescription
            }

            $pageResults.Add($pageData)

            $result = Add-UckkLocalStep -Result $result -Step (
                New-UckkLocalStep `
                    -Name "Tester $path" `
                    -Status $(if ($ok) { 'Réussi' } else { 'Échoué' }) `
                    -Summary "HTTP $($response.StatusCode)" `
                    -Detail $url `
                    -Data $pageData
            )

            if (-not $ok) {
                $result = Add-UckkLocalError -Result $result -ErrorMessage "La page locale ne répond pas correctement : $url"
            }
        }
        catch {
            $pageData = [pscustomobject]@{
                path       = $path
                url        = $url
                statusCode = $null
                success    = $false
                detail     = $_.Exception.Message
            }

            $pageResults.Add($pageData)

            $result = Add-UckkLocalStep -Result $result -Step (
                New-UckkLocalStep `
                    -Name "Tester $path" `
                    -Status 'Échoué' `
                    -Summary 'La page locale ne répond pas correctement.' `
                    -Detail "$url — $($_.Exception.Message)" `
                    -Data $pageData
            )

            $result = Add-UckkLocalError -Result $result -ErrorMessage "La page locale ne répond pas : $url"
        }
    }

    $result.data = [pscustomobject]@{
        baseUrl = $baseUrl
        pages   = $pageResults
    }

    if ((Get-UckkLocalResultListCount -Result $result -PropertyName 'errors') -gt 0) {
        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Échoué — une ou plusieurs pages locales ne répondent pas correctement.' `
            -NextStep 'Démarrer Moodle local, purger les caches locaux, puis relancer le test.'
    }

    $result = Add-UckkLocalWarning `
        -Result $result `
        -Warning 'HTTP 200 confirme que la page répond, mais ne confirme pas toujours l affichage complet ou les données chargées par AJAX.'

    return Complete-UckkLocalResult `
        -Result $result `
        -Summary 'Réussi avec avertissements — les pages locales testées répondent.' `
        -NextStep 'Vérifier dans le navigateur les pages qui dépendent de JavaScript ou AJAX.'
}

function Get-UckkLocalStatus {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [object] $Config
    )

    $action = 'Vérifier l état local'

    $result = New-UckkLocalResult `
        -Action $action `
        -Target 'local' `
        -DangerLevel 1 `

        -Mode 'vérification' `
        -Status 'En cours' `
        -Summary 'Vérification rapide de l état local.'

    $pathResult = Test-UckkLocalPaths -Config $Config

    $result.data = [pscustomobject]@{
        paths = $pathResult.data
    }

    if ((Get-UckkLocalResultListCount -Result $pathResult -PropertyName 'errors') -gt 0) {
        $result = Add-UckkLocalStep -Result $result -Step (
            New-UckkLocalStep `
                -Name 'Vérifier chemins locaux' `
                -Status 'Échoué' `
                -Summary 'Les chemins locaux ne sont pas tous valides.' `
                -Data $pathResult
        )

        $result = Add-UckkLocalError -Result $result -ErrorMessage 'Les chemins locaux obligatoires ne sont pas tous valides.'

        return Complete-UckkLocalResult `
            -Result $result `
            -Summary 'Échoué — l état local n est pas prêt.' `
            -NextStep 'Corriger les chemins locaux avant de continuer.'
    }

    $result = Add-UckkLocalStep -Result $result -Step (
        New-UckkLocalStep `
            -Name 'Vérifier chemins locaux' `
            -Status 'Réussi' `
            -Summary 'Les chemins locaux obligatoires sont valides.' `
            -Data $pathResult
    )

    return Complete-UckkLocalResult `
        -Result $result `
        -Summary 'Réussi — l état local de base est prêt.' `
        -NextStep 'Synchroniser source vers Moodle local ou tester les pages locales.'
}

Export-ModuleMember -Function `
    Test-UckkLocalPaths, `
    Sync-UckkSourceToLocalMoodle, `
    Clear-UckkLocalMoodleCaches, `
    Start-UckkLocalMoodle, `
    Open-UckkLocalMoodle, `
    Test-UckkLocalPages, `
    Get-UckkLocalStatus
--- CHUNK END ---
